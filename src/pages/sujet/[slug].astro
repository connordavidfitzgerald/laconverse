---
import View from "../../views/Category.astro";
import { getTag, getTags } from "../../lib/content";

export async function getStaticPaths() {
  const slugs: string[] = await getTags("fr").then((list) => list.map((c) => c.slug));
  return slugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug!;
const tag = await getTag("fr", slug);
if (!tag) return new Response(null, { status: 404 });
---

<View lang="fr" category={tag} kind="tag" />
