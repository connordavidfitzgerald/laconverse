---
import View from "../../../views/Author.astro";
import { getAuthor, getPeopleSlugs } from "../../../lib/content";

export async function getStaticPaths() {
  const slugs: string[] = await getPeopleSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug!;
const person = await getAuthor("en", slug);
if (!person) return new Response(null, { status: 404 });
---

<View lang="en" person={person} />
