---
import View from "../../../views/Podcast.astro";
import { getPodcast, getPodcasts } from "../../../lib/content";

export async function getStaticPaths() {
  const slugs: string[] = await getPodcasts("en").then((list) => list.map((p) => p.slug));
  return slugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug!;
const podcast = await getPodcast("en", slug);
if (!podcast) return new Response(null, { status: 404 });
---

<View lang="en" podcast={podcast} />
