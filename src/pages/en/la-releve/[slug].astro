---
import View from "../../../views/Program.astro";
import { getProgram, getProgramSlugs } from "../../../lib/content";

export async function getStaticPaths() {
  const slugs: string[] = await getProgramSlugs("en");
  return slugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug!;
const program = await getProgram("en", slug);
if (!program) return new Response(null, { status: 404 });
---

<View lang="en" program={program} />
