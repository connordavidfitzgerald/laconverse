---
/* A Sanity image in a fixed-ratio frame, cropped by its hotspot. With no image
   (fixtures, or an article imported without one) the frame keeps its size and
   shows its flat placeholder colour so the layout never collapses. The image
   fades in over that colour once it loads (`fadeImages` in lib/motion). */
import { placeholder } from "../lib/placeholder";
import { imageUrl, srcset } from "../lib/sanity";
import type { Img } from "../lib/types";

interface Props {
  img?: Img | null;
  /** width / height, e.g. 4/3. Omit to use the image's own proportions. */
  ratio?: number;
  sizes?: string;
  widths?: number[];
  class?: string;
  imgClass?: string;
  eager?: boolean;
  alt?: string;
}

const {
  img,
  ratio,
  sizes = "100vw",
  widths = [400, 640, 960, 1280, 1920],
  class: className,
  imgClass,
  eager = false,
  alt,
} = Astro.props;
const dims = img?.asset?.metadata?.dimensions;
const r = ratio ?? (dims ? dims.width / dims.height : 4 / 3);
const src = imageUrl(img, 1280, ratio ? Math.round(1280 / ratio) : undefined);
const set = srcset(img, widths, ratio);
const fill = placeholder(img?.asset?._id ?? src ?? "");
---

<div
  data-media
  class:list={["relative overflow-hidden", className]}
  style={`aspect-ratio: ${r}; background-color: ${fill}`}
>
  {src && (
    <img
      src={src}
      srcset={set}
      sizes={set ? sizes : undefined}
      alt={alt ?? img?.alt ?? ""}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
      class:list={["absolute inset-0 size-full object-cover", imgClass]}
    />
  )}
</div>
