---
import Icon from "./Icon.astro";
import type { Settings } from "../lib/types";

interface Props {
  socials: Settings["socials"];
  variant?: "round" | "plain" | "text";
  class?: string;
  /** Text variant only: override the link size (defaults to 24 → 30px). */
  size?: string;
}
const { socials, variant = "round", class: className, size = "text-2xl lg:text-3xl" } = Astro.props;
const names: Record<string, string> = {
  instagram: "Instagram",
  tiktok: "TikTok",
  whatsapp: "WhatsApp",
  linkedin: "LinkedIn",
  facebook: "Facebook",
  youtube: "YouTube",
  x: "X",
};
---

<ul
  class:list={[
    "flex items-center",
    variant === "round" ? "gap-[5px] md:gap-1.5" : variant === "text" ? "flex-wrap gap-x-5 lg:gap-x-10 lg:gap-y-2.5" : "gap-4",
    className,
  ]}
>
  {socials.map(({ platform, url }) => variant === "text" ? (
    <li>
      <a
        href={url}
        target="_blank"
        rel="noopener"
        class:list={["link-line decoration-2 label inline-flex items-center gap-1", size]}
      >
        {names[platform] ?? platform}
        <span aria-hidden="true" class="nudge-ne inline-block font-medium">↗</span>
      </a>
    </li>
  ) : (
    <li>
      <a
        href={url}
        target="_blank"
        rel="noopener"
        aria-label={names[platform] ?? platform}
        class:list={[
          "grid place-items-center",
          variant === "round"
            ? "press size-11 rounded-full bg-ink text-yellow hover:bg-paper hover:text-ink md:size-[53px]"
            : "press size-5 text-ink hover:opacity-60",
        ]}
      >
        <Icon name={platform} class={variant === "round" ? "size-4 md:size-5" : "size-5"} />
      </a>
    </li>
  ))}
</ul>
