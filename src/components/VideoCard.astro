---
import Chip from "./Chip.astro";
import Picture from "./Picture.astro";
import { formatDuration, href, type Lang } from "../i18n";
import type { VideoCard } from "../lib/types";
import { videoKindLabel } from "../lib/videoKinds";

interface Props {
  video: VideoCard;
  lang: Lang;
  class?: string;
}
const { video, lang, class: className } = Astro.props;
const [category] = video.categories;
const kind = videoKindLabel(video.kind, lang);
---

<!-- Same anatomy as ArticleCard: image, then the type (or section) across
     from the duration, then the title. -->
<article
  class:list={["group relative flex flex-col", className]}
  lang={video.lang && video.lang !== lang ? video.lang : undefined}
>
  <Picture
    img={video.poster}
    ratio={9 / 16}
    class="media-inset"
    sizes="(min-width: 1024px) 20vw, 55vw"
  />
  <div class="flex flex-col gap-1 py-2 md:gap-2.5 md:pt-4 md:pb-6">
    <div class="flex items-center justify-between gap-2 py-2 md:py-0">
      {kind ? (
        <span
          lang={lang}
          class="label inline-flex items-baseline gap-[0.45em] whitespace-nowrap text-ink font-medium text-[calc(1rem*var(--type-scale,1))]"
        >
          <span aria-hidden="true" class="size-[1cap] shrink-0 bg-yellow" />
          {kind}
        </span>
      ) : category ? (
        <Chip
          category={category}
          lang={lang}
          class="relative z-10 text-[calc(1rem*var(--type-scale,1))]!"
        />
      ) : (
        <span />
      )}
      <span class="label shrink-0 text-[calc(1rem*var(--type-scale,1))]! font-medium whitespace-nowrap opacity-60">
        {formatDuration(video.duration)}
      </span>
    </div>
    <h3 class="display font-black leading-[95%] text-card-sm">
      <a
        href={`${href(lang, "videos")}#${video.slug}`}
        class="title-line after:absolute after:inset-0"
      >
        {video.title}
      </a>
    </h3>
  </div>
</article>
