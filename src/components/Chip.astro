---
import { href, type Lang } from "../i18n";
import { dotClass } from "../lib/chip";
import type { CategoryRef } from "../lib/types";

interface Props {
  category: CategoryRef;
  lang: Lang;
  size?: "sm" | "md";
  class?: string;
  [attr: `data-${string}`]: unknown;
}
const { category, lang, size = "sm", class: className, ...rest } = Astro.props;
---

<a
  href={href(lang, "category", category.slug)}
  class:list={[
    "label inline-flex items-center gap-[0.45em] bg-white whitespace-nowrap hover:bg-ink hover:text-yellow font-black",
    size === "sm" ? " text-md " : " text-md",
    className,
  ]}
  {...rest}
>
  <span
    aria-hidden="true"
    data-dot
    class:list={["size-[0.6em] shrink-0 rounded-full", dotClass(category.slug)]}
  ></span>
  <span data-label>{category.title}</span>
</a>
