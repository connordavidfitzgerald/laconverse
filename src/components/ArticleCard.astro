---
/* The story card used everywhere: image, category chip, byline + date, title.
   `size` only changes the title scale and image ratio — the anatomy is fixed.
   The data-* hooks let ArticleGrid reuse a blank card as its client-side
   template (filled by `cardLinks` in lib/searchClient). */
import Chip from "./Chip.astro";
import Picture from "./Picture.astro";
import { formatDate, href, type Lang } from "../i18n";
import type { ArticleCard } from "../lib/types";

interface Props {
  article: ArticleCard;
  lang: Lang;
  size?: "lg" | "md" | "sm";
  sizes?: string;
  class?: string;
}
const {
  article,
  lang,
  size = "lg",
  sizes = "(min-width: 768px) 33vw, 100vw",
  class: className,
} = Astro.props;
const url = href(lang, "article", article.slug);
const [category] = article.categories;
---

<article class:list={["group relative flex flex-col", className]}>
  <Picture img={article.image} ratio={16 / 9} sizes={sizes} class="media-inset" />
  <div class="@container flex flex-col gap-1 py-2 md:gap-2.5 md:pt-4 md:pb-6">
    <div class="flex items-center justify-between gap-2 py-2 md:py-0">
      {category ? (
        <Chip category={category} lang={lang} class="relative z-10" data-chip />
      ) : (
        <span />
      )}
      <!-- Too narrow for the byline beside the chip (the homepage side stories
           around 1024–1180px): drop it. -->
      <p class="label hidden min-w-0 gap-[5px] text-sm font-extrabold md:tracking-[-0.01em] @min-[16.5rem]:flex">
        {article.authors[0] && (
          <a
            href={href(lang, "author", article.authors[0].slug)}
            data-author
            class="relative z-10 hidden truncate link-line @min-[20rem]:inline"
          >
            {article.authors[0].name}
          </a>
        )}
        <time
          data-date
          datetime={article.publishedAt}
          class="shrink-0 whitespace-nowrap opacity-60"
        >
          {formatDate(lang, article.publishedAt)}
        </time>
      </p>
    </div>
    <h3
      class:list={[
        "display font-black leading-[95%]  ",
        size === "sm"
          ? "text-card-sm"
          : size === "md"
            ? "text-card-sm md:text-[1.25rem]"
            : "text-[1.75rem] md:tracking-[-0.02em]",
      ]}
    >
      <a href={url} data-title class="title-line after:absolute after:inset-0">
        {article.title}
      </a>
    </h3>
  </div>
</article>
