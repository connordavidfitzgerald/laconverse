---
/* Calls to action woven into the article body: after roughly every two
   screens of reading, the next one of share your story → donate → newsletter
   drops in after a paragraph (never after a heading, never in the last half
   screen). Screens differ per device, so placement is measured in the browser;
   without JS the article simply reads uninterrupted. Wraps the prose element,
   which must carry `data-cta-body`. */
import AjaxForm from "./AjaxForm.astro";
import DonateWidget from "./DonateWidget.astro";
import Icon from "./Icon.astro";
import { t, type Lang } from "../i18n";
import { getDonate, getSettings } from "../lib/content";

interface Props {
  lang: Lang;
  /** The question on the story panel; the article's own, else the generic. */
  storyPrompt?: string | null;
  /** Screens of reading between two calls to action. */
  every?: number;
}
const { lang, storyPrompt, every = 2 } = Astro.props;
const s = t(lang);
const [settings, donate] = await Promise.all([getSettings(lang), getDonate(lang)]);

/* Donate and newsletter share the donate widget's look: white, ruled top and
   bottom, a Favorit title, then rounded mist tiles. Share your story
   stands apart as a black call-out (see its template). The prose styles reach into the
   body, so each panel opts out with `data-no-prose`. */
const panel = "my-14! border-y border-ink py-10 sm:py-14";
const title = "display max-w-[12em] text-[2.5rem] leading-[0.95]";
const tile =
  "label flex h-14 items-center justify-center gap-2 rounded-xl px-5 text-copy transition-colors lg:rounded-[20px]";
const mist = "bg-mist text-ink hover:bg-yellow/50";
---

<article-ctas data-every={every} class="block">
  <slot />

  <template>
    <!-- Share your story: a black call-out (like the menu's), the article's
         own question in yellow, then the recorder — a big pulsing mic with
         its label — and a pill to write instead. -->
    <aside
      data-no-prose
      class="my-14! flex flex-col items-center overflow-hidden rounded-[20px] bg-ink p-6 text-center text-paper sm:p-10"
      aria-label={s.vnFab}
    >
      <p class="display max-w-[14em] text-balance text-[2.5rem] leading-[0.95] text-yellow sm:text-[3.25rem]">
        {storyPrompt || s.vnTitle}
      </p>
      <p class="prose-sans mt-5 max-w-[30em] text-paper/80">{s.ctaStoryText}</p>

      <!-- Two round buttons: the mic records a voice note, the pen writes. -->
      <div class="mt-8 flex w-full items-center justify-center gap-4 border-t border-paper/20 pt-8 sm:mt-10">
        <button
          type="button"
          data-voice-open
          title={s.vnOpen}
          class="press group relative grid size-[84px] shrink-0 place-items-center rounded-full bg-yellow text-ink transition-transform hover:scale-105"
          aria-label={s.vnOpen}
        >
          <span
            aria-hidden="true"
            class="absolute inset-0 animate-ping rounded-full bg-yellow/40 [animation-duration:2s] motion-reduce:hidden"
          ></span>
          <Icon name="mic" class="relative h-[23px] w-[22px]" />
        </button>
        <button
          type="button"
          data-voice-open="write"
          title={s.vnWrite}
          class="press grid size-[84px] shrink-0 place-items-center rounded-full border border-paper/40 text-paper transition-[transform,background-color,border-color,color] hover:scale-105 hover:border-yellow hover:bg-yellow hover:text-ink"
          aria-label={s.vnWrite}
        >
          <Icon name="pen" class="h-[23px] w-[22px]" />
        </button>
      </div>
    </aside>
  </template>

  <template>
    <!-- Donate: a light grey rounded box, the same shape as the story
         call-out; its grey tiles turn white so they stand out (chosen ones
         keep their wine). -->
    <aside
      data-no-prose
      class="my-14! overflow-hidden rounded-[20px] bg-mist p-6 text-ink sm:p-10 [&_:is(.bg-mist,.btn):not([aria-pressed=true],[aria-checked=true],:hover)]:bg-paper"
      aria-label={s.donate}
    >
      <DonateWidget lang={lang} data={donate} stacked />
    </aside>
  </template>

  <template>
    <aside data-no-prose class={panel} aria-label={s.subscribe}>
      <p class={title}>{s.ctaNewsletterTitle}</p>
      <AjaxForm
        action={settings.newsletterAction ?? "/api/contact"}
        external={!!settings.newsletterAction}
        lang={lang}
        class="mt-10"
      >
        <input type="hidden" name="kind" value="newsletter" />
        <input type="hidden" name="context" value="article" />
        <div class="grid gap-2.5 sm:grid-cols-[1fr_auto]">
          <input
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder={s.email}
            aria-label={s.email}
            class:list={[tile, mist, "min-w-0 justify-start placeholder:text-ink/50 outline-none focus-visible:ring-2 focus-visible:ring-ink [&:not(:placeholder-shown)]:normal-case"]}
          />
          <button type="submit" class="btn btn-compact press w-full sm:w-[10.5rem]">
            {s.subscribe}
          </button>
        </div>
      </AjaxForm>
    </aside>
  </template>

</article-ctas>

<script>
  class ArticleCtas extends HTMLElement {
    async connectedCallback() {
      const body = this.querySelector<HTMLElement>("[data-cta-body]");
      const ctas = [...this.querySelectorAll("template")];
      if (!body || !ctas.length) return;
      // Measure with the real fonts, or line wrapping (and so height) is off.
      await document.fonts?.ready;

      const screen = window.innerHeight;
      const step = screen * Number(this.dataset.every ?? 2);
      const top = body.getBoundingClientRect().top;
      const end = body.getBoundingClientRect().bottom - top;

      // Pick every anchor first, then insert, so one insertion doesn't shift
      // the measurements for the next.
      const anchors: Element[] = [];
      let next = step;
      for (const el of body.children) {
        const bottom = el.getBoundingClientRect().bottom - top;
        if (bottom < next || !el.matches("p, ul, ol, blockquote, figure")) continue;
        if (end - bottom < screen / 2) break;
        anchors.push(el);
        next = bottom + step;
      }
      anchors.forEach((el, i) => el.after(ctas[i % ctas.length].content.cloneNode(true)));
    }
  }
  customElements.define("article-ctas", ArticleCtas);
</script>
