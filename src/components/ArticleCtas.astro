---
/* Calls to action woven into the article body: after roughly every two
   screens of reading, the next one of donate → newsletter → share your story
   drops in after a paragraph (never after a heading, never in the last half
   screen). Screens differ per device, so placement is measured in the browser;
   without JS the article simply reads uninterrupted. Wraps the prose element,
   which must carry `data-cta-body`. */
import AjaxForm from "./AjaxForm.astro";
import DonateWidget from "./DonateWidget.astro";
import Icon from "./Icon.astro";
import { t, type Lang } from "../i18n";
import { getDonate, getSettings } from "../lib/content";

interface Props {
  lang: Lang;
  /** The question on the story panel; the article's own, else the generic. */
  storyPrompt?: string | null;
  /** Screens of reading between two calls to action. */
  every?: number;
}
const { lang, storyPrompt, every = 2 } = Astro.props;
const s = t(lang);
const [settings, donate] = await Promise.all([getSettings(lang), getDonate(lang)]);

/* The three article CTAs (donate, newsletter, share your story) share the
   donate widget's look: white, ruled top and bottom, a Favorit title over a
   caps line, then rounded mist/yellow tiles. The prose styles reach into the
   body, so each panel opts out with `data-no-prose`. */
const panel = "my-14! border-y border-ink py-10 sm:py-14";
const title = "display max-w-[12em] text-[2.5rem] leading-[0.95]";
const line = "label mt-5 text-copy leading-[0.95]";
const tile =
  "label flex h-14 items-center justify-center gap-2 rounded-xl px-5 text-copy transition-colors lg:rounded-[20px]";
const mist = "bg-mist text-ink hover:bg-yellow/50";
const yellow = "bg-yellow text-ink hover:bg-ink hover:text-yellow";
---

<article-ctas data-every={every} class="block">
  <slot />

  <template>
    <aside data-no-prose class={panel} aria-label={s.donate}>
      <DonateWidget lang={lang} data={donate} stacked />
    </aside>
  </template>

  <template>
    <aside data-no-prose class={panel} aria-label={s.subscribe}>
      <p class={title}>{s.ctaNewsletterTitle}</p>
      <AjaxForm
        action={settings.newsletterAction ?? "/api/contact"}
        external={!!settings.newsletterAction}
        lang={lang}
        class="mt-10"
      >
        <input type="hidden" name="kind" value="newsletter" />
        <input type="hidden" name="context" value="article" />
        <div class="grid gap-2.5 sm:grid-cols-[1fr_auto]">
          <input
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder={s.email}
            aria-label={s.email}
            class:list={[tile, mist, "min-w-0 justify-start placeholder:text-ink/50 outline-none focus-visible:ring-2 focus-visible:ring-ink [&:not(:placeholder-shown)]:normal-case"]}
          />
          <button type="submit" class:list={[tile, yellow, "press disabled:opacity-50 sm:w-[10.5rem]"]}>
            {s.subscribe}
          </button>
        </div>
      </AjaxForm>
    </aside>
  </template>

  <template>
    <aside data-no-prose class={panel} aria-label={s.vnFab}>
      <p class={title}>{storyPrompt || s.vnTitle}</p>
      <p class={line}>{s.ctaStoryText}</p>
      <div class="mt-10 grid grid-cols-2 gap-2.5">
        <button type="button" data-voice-open class:list={[tile, yellow, "press"]}>
          <Icon name="mic" class="size-4" />
          {s.vnTap}
        </button>
        <button type="button" data-voice-open="write" class:list={[tile, mist, "press"]}>
          {s.vnWrite}
        </button>
      </div>
    </aside>
  </template>
</article-ctas>

<script>
  class ArticleCtas extends HTMLElement {
    async connectedCallback() {
      const body = this.querySelector<HTMLElement>("[data-cta-body]");
      const ctas = [...this.querySelectorAll("template")];
      if (!body || !ctas.length) return;
      // Measure with the real fonts, or line wrapping (and so height) is off.
      await document.fonts?.ready;

      const screen = window.innerHeight;
      const step = screen * Number(this.dataset.every ?? 2);
      const top = body.getBoundingClientRect().top;
      const end = body.getBoundingClientRect().bottom - top;

      // Pick every anchor first, then insert, so one insertion doesn't shift
      // the measurements for the next.
      const anchors: Element[] = [];
      let next = step;
      for (const el of body.children) {
        const bottom = el.getBoundingClientRect().bottom - top;
        if (bottom < next || !el.matches("p, ul, ol, blockquote, figure")) continue;
        if (end - bottom < screen / 2) break;
        anchors.push(el);
        next = bottom + step;
      }
      anchors.forEach((el, i) => el.after(ctas[i % ctas.length].content.cloneNode(true)));
    }
  }
  customElements.define("article-ctas", ArticleCtas);
</script>
