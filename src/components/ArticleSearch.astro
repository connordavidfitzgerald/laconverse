---
/* The search page (Figma: Sujet — gabarit): the search form (default slot,
   with an input id="q") across the page, then the explorer list in cols 1–4
   beside two-up story cards in 5–12 (the picked section's description sits
   between the two), filtering the full index client-side.
   The index is fetched on first use, so the server-rendered cards stand until
   then. */
import ArticleGrid from "./ArticleGrid.astro";
import SectionIntro from "./SectionIntro.astro";
import ExploreNav from "./ExploreNav.astro";
import { t, type Lang } from "../i18n";
import type { ArticleCard } from "../lib/types";

interface Props {
  lang: Lang;
  categories: { title: string; slug: string; description?: string | null; count: number }[];
  articles: ArticleCard[];
  total: number;
  /** Mirror the query and category in the URL (?q=, ?c=). */
  syncUrl?: boolean;
  /** Cards per page; `articles` should be the first page. */
  pageSize?: number;
  moreLabel?: string;
  /** Article ids to leave out of the index (already shown elsewhere on the page). */
  exclude?: string[];
  class?: string;
}
const {
  lang,
  categories,
  articles,
  total,
  syncUrl = false,
  pageSize = 12,
  moreLabel,
  exclude = [],
  class: className,
} = Astro.props;
const s = t(lang);
---

<article-search
  class:list={["block", className]}
  data-lang={lang}
  data-results={s.results}
  data-none={s.noResults}
  data-total={total}
  data-page={pageSize}
  data-sync={syncUrl ? "" : undefined}
  data-exclude={exclude.length ? exclude.join(" ") : undefined}
>
  <slot />
  {/* The current section's description; update() swaps it by toggling
      `hidden` on `[data-desc]`. */}
  <section aria-live="polite">
    {categories.map((c) => c.description && (
      <SectionIntro lang={lang} category={c} data-desc={c.slug} hidden />
    ))}
  </section>
  <div class="pt-10 lg:page-grid lg:pt-20" data-explore>
    <ExploreNav lang={lang} categories={categories} asFilter class="pb-10 lg:sticky lg:top-[calc(var(--header-h)+2.5rem)] lg:col-span-4 lg:self-start lg:pb-0" />
    <div class="lg:col-span-8 lg:col-start-5">
      <ArticleGrid lang={lang} articles={articles} total={total} moreLabel={moreLabel} managed explore />
    </div>
  </div>
</article-search>

<script>
  import { fadeImages } from "../lib/motion";
  import { cardLinks, fold, loadIndex, type Entry } from "../lib/searchClient";
  import { scrollToExplorer } from "../lib/smoothScroll";


  const articles = (el: HTMLElement) => el.querySelector("[data-list]")!.childElementCount;

  class ArticleSearch extends HTMLElement {
    entries: Entry[] | null = null;
    results: Entry[] = [];
    shown = 0;
    query = "";
    category = "";
    page = 12;

    connectedCallback() {
      this.page = Number(this.dataset.page);
      const input = this.querySelector<HTMLInputElement>("#q");
      if (this.hasAttribute("data-sync")) {
        const params = new URLSearchParams(location.search);
        this.query = params.get("q") ?? "";
        this.category = params.get("c") ?? "";
        if (input) input.value = this.query;
      }

      this.querySelector("form")?.addEventListener("submit", (e) => {
        e.preventDefault();
        this.update();
      });
      let timer = 0;
      input?.addEventListener("input", () => {
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          this.query = input.value;
          this.update();
        }, 150);
      });
      this.querySelectorAll<HTMLAnchorElement>("[data-filter]").forEach((a) =>
        a.addEventListener("click", async (e) => {
          e.preventDefault();
          this.category = a.dataset.filter ?? "";
          // After the update: the description above the row swaps in it, which
          // moves the row.
          await this.update();
          scrollToExplorer(this, { onlyUp: true });
        }),
      );
      const more = this.querySelector<HTMLButtonElement>("[data-more]")!;
      more.onclick = async () => {
        // Still showing the server-rendered cards: filter first, then page on.
        if (!this.entries) await this.update(false);
        this.more();
      };
      if (this.query || this.category) this.update(false);
      else more.closest("p")!.hidden = articles(this) >= Number(this.dataset.total);
    }

    /** `animate` is off for the first render, which replaces the server-rendered
        cards in place and shouldn't flicker. */
    async update(animate = true) {
      if (!this.entries) {
        const exclude = new Set(this.dataset.exclude?.split(" "));
        this.entries = (await loadIndex(this.dataset.lang!)).filter((e) => !exclude.has(e.id));
      }
      const q = fold(this.query.trim());
      this.results = this.entries.filter(
        (e) =>
          (!this.category || e.c.some((c) => c.slug === this.category)) &&
          (!q ||
            fold(
              `${e.t} ${e.d ?? ""} ${e.a.map((a) => a.name).join(" ")} ${e.c.map((c) => c.title).join(" ")}`,
            ).includes(q)),
      );
      this.querySelectorAll<HTMLAnchorElement>("[data-filter]").forEach((a) =>
        a.setAttribute("aria-current", String((a.dataset.filter ?? "") === this.category)),
      );
      this.querySelectorAll<HTMLElement>("[data-desc]").forEach((p) => {
        p.hidden = p.dataset.desc !== this.category;
      });
      if (this.hasAttribute("data-sync")) {
        const url = new URL(location.href);
        this.query ? url.searchParams.set("q", this.query) : url.searchParams.delete("q");
        this.category ? url.searchParams.set("c", this.category) : url.searchParams.delete("c");
        history.replaceState(null, "", url);
      }

      const list = this.querySelector("[data-list]")!;
      list.replaceChildren();
      this.shown = 0;
      this.more(animate);
      const count = this.querySelector("[data-count]")!;
      count.textContent = this.results.length
        ? `${this.results.length} ${this.dataset.results}`
        : this.dataset.none!;
      // The bar is hidden beside the explorer; it only surfaces to say "no results".
      count.parentElement!.classList.toggle("hidden", this.results.length > 0);
    }

    more(animate = true) {
      const tpl = this.querySelector<HTMLTemplateElement>("[data-card]")!;
      const list = this.querySelector("[data-list]")!;
      const added: Element[] = [];
      for (const e of this.results.slice(this.shown, this.shown + this.page)) {
        const node = tpl.content.cloneNode(true) as DocumentFragment;
        cardLinks(node, e, this.dataset.lang!);
        added.push(...node.children);
        list.append(node);
      }
      if (animate) fadeImages(added);
      this.shown = Math.min(this.results.length, this.shown + this.page);
      this.querySelector("[data-more]")!.closest("p")!.hidden = this.shown >= this.results.length;
    }
  }
  customElements.define("article-search", ArticleSearch);
</script>
