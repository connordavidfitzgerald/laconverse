---
/* Yellow footer (Figma: La Converse — Site / Footer). From `lg` it sits on the
   12-column grid: three nav columns at 1–3, contact at 7, donate at 10; the
   newsletter at 1–5 and socials at 7–11 below. Phones (no frame) drop the nav
   and stack the rest, left-aligned. It is only as tall as its content.

   Curtain reveal: the footer is sticky underneath the page (z -1, `main`
   carries the page background over it; `body` is `isolate` so the negative
   z-index stays above body's own box — otherwise body swallows every click
   on the footer), so the content lifts away to uncover
   it rather than the footer scrolling in. Its sticky `bottom` is
   min(0, viewport − footer height): a footer that fits stays pinned to the
   bottom of the screen; a taller one pins its top to the top of the screen
   and scrolls the rest normally once uncovered. The height comes from the
   ResizeObserver below (without JS it falls back to `bottom: 0`). */
import Icon from "./Icon.astro";
import Socials from "./Socials.astro";
import AjaxForm from "./AjaxForm.astro";
import { href, t, type Lang } from "../i18n";
import type { Settings } from "../lib/types";

interface Props {
  lang: Lang;
  settings: Settings;
  alternate: string;
}
const { lang, settings } = Astro.props;
const s = t(lang);
const donate = href(lang, "donate");

const nav = [
  [
    { label: s.about, url: href(lang, "about") },
    { label: s.careers, url: `${href(lang, "about")}#careers` },
    { label: s.ecole, url: href(lang, "ecole") },
  ],
  [
    { label: s.involve, url: href(lang, "involve") },
    { label: s.donate, url: donate },
    { label: s.contact, url: href(lang, "contact") },
  ],
  [
    { label: s.studio, url: href(lang, "studio") },
    { label: s.videos, url: href(lang, "videoIndex") },
    { label: s.podcasts, url: href(lang, "podcasts") },
  ],
].map((col) => col.sort((a, b) => a.label.localeCompare(b.label, lang)));
---

<footer
  data-site-footer
  class="sticky -z-1 bottom-[min(0px,100dvh_-_var(--footer-h,0px))] bg-yellow px-5 pt-10 pb-5 lg:px-page lg:pb-10"
>
  <div class="grid grid-cols-3 gap-x-5 gap-y-15 lg:page-grid lg:gap-y-10">
    <!-- Site nav -->
    <nav class="col-span-3 hidden grid-cols-subgrid lg:grid">
      {nav.map((col) => (
        <ul class="label text-lg leading-[1.05]">
          {col.map((l) => (
            <li>
              <a href={l.url} class="link-line decoration-2 whitespace-nowrap">{l.label}</a>
            </li>
          ))}
        </ul>
      ))}
    </nav>

    <!-- Contact -->
    <div class="col-span-3 flex flex-col gap-1 lg:col-span-3 lg:col-start-7 lg:gap-2">
      <p class="label text-lg">{s.contact}</p>
      <a
        href={`mailto:${settings.email}`}
        class="link-line decoration-2 label inline-flex items-center gap-1 self-start text-2xl lg:text-3xl"
      >
        {settings.email}
        <Icon name="arrow-ne" class="nudge-ne size-4" />
      </a>
    </div>

    <!-- Donate -->
    <div class="col-span-3 flex flex-col gap-1 lg:col-span-2 lg:col-start-10 lg:gap-2">
      <p class="label text-lg">{s.donate}</p>
      <a href={donate} class="link-line decoration-2 label inline-flex items-center gap-1 self-start text-2xl lg:text-3xl">
        <span class="whitespace-nowrap">{s.supportUs}</span>
        <Icon name="arrow-ne" class="nudge-ne size-4" />
      </a>
    </div>

    <!-- Newsletter -->
    <div class="col-span-3 lg:col-span-5">
      <label class="label block text-lg" for="newsletter-email">{s.newsletter}</label>
      <AjaxForm
        action={settings.newsletterAction ?? "/api/contact"}
        external={!!settings.newsletterAction}
        lang={lang}
        class="mt-1 lg:mt-2"
      >
        <input type="hidden" name="kind" value="newsletter" />
        <input type="hidden" name="context" value="footer" />
        <div class="relative flex items-center gap-1 border-b border-ink pb-2.5 after:absolute after:inset-x-0 after:-bottom-px after:h-[3px] after:origin-left after:scale-x-0 after:bg-ink after:transition-transform after:duration-500 after:ease-[cubic-bezier(0.2,0.7,0.2,1)] has-[input:focus-visible]:after:scale-x-100">
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder={s.email}
            class="label min-w-0 flex-1 bg-transparent text-2xl lg:text-3xl placeholder:text-ink outline-none"
          />
          <button type="submit" class="group grid size-6 shrink-0 place-items-center disabled:opacity-50" aria-label={s.subscribe}>
            <Icon name="arrow-ne" class="nudge-ne size-4" />
          </button>
        </div>
      </AjaxForm>
    </div>

    <!-- Socials -->
    <div class="col-span-3 flex flex-col gap-1 lg:col-span-5 lg:col-start-7 lg:gap-2">
      <p class="label text-lg">{s.followUs}</p>
      <Socials socials={settings.socials} variant="text" />
    </div>
  </div>
</footer>

<script>
  const footer = document.querySelector<HTMLElement>("[data-site-footer]");
  if (footer) {
    const set = () => footer.style.setProperty("--footer-h", `${footer.offsetHeight}px`);
    new ResizeObserver(set).observe(footer);
    set();
  }
</script>
