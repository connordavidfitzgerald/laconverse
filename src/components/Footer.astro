---
/* Yellow footer with the giant « » (Figma: FOOTER / FOOTER — DESKTOP). Phones
   stack everything centred; from `lg` it spreads into the desktop layout:
   contact + donate top-left, newsletter top-right, socials under them. */
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import Socials from "./Socials.astro";
import Spray from "./Spray.astro";
import AjaxForm from "./AjaxForm.astro";
import { href, t, type Lang } from "../i18n";
import type { Settings } from "../lib/types";

interface Props {
  lang: Lang;
  settings: Settings;
  alternate: string;
}
const { lang, settings, alternate } = Astro.props;
const s = t(lang);
const donate = settings.donateUrl ?? `${href(lang, "getInvolved")}#donate`;
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-yellow px-5 pt-5 pb-10 lg:px-10 lg:pt-10 lg:pb-10">
  <Spray
    class="-left-[107%] top-[62%] w-[325%] -rotate-[22deg] lg:-left-[36%] lg:top-[28%] lg:w-[132%]"
    seed={4}
  />

  <div class="relative grid gap-10 text-center lg:grid-cols-12 lg:gap-x-5 lg:gap-y-[4.5rem] lg:text-left">
    <!-- Newsletter -->
    <div class="order-1 lg:order-3 lg:col-span-5 lg:col-start-8" data-reveal>
      <p class="display mx-auto max-w-[20rem] text-lg leading-[0.95] tracking-[-0.01em] lg:mx-0 lg:max-w-[26rem]">
        {s.newsletter}
      </p>
      <AjaxForm
        action={settings.newsletterAction ?? "/api/contact"}
        external={!!settings.newsletterAction}
        lang={lang}
        class="mt-5"
      >
        <input type="hidden" name="kind" value="newsletter" />
        <input type="hidden" name="context" value="footer" />
        <div class="relative flex items-end gap-2.5 border-b border-ink pb-3 after:absolute after:inset-x-0 after:-bottom-px after:h-[3px] after:origin-left after:scale-x-0 after:bg-ink after:transition-transform after:duration-500 after:ease-[cubic-bezier(0.2,0.7,0.2,1)] has-[input:focus-visible]:after:scale-x-100">
          <label class="sr-only" for="newsletter-email">
            {s.email}
          </label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder={s.email}
            class="display min-w-0 flex-1 bg-transparent text-2xl tracking-[-0.02em] placeholder:text-ink outline-none lg:text-[1.875rem]"
          />
          <button
            type="submit"
            class="press label shrink-0 rounded-[10px] border border-ink px-5 py-3 text-base hover:bg-ink hover:text-yellow disabled:opacity-50 lg:px-[30px] lg:py-[15px] lg:text-[1.0625rem]"
          >
            {s.subscribe}
          </button>
        </div>
      </AjaxForm>
    </div>

    <!-- Contact -->
    <div class="order-2 flex flex-col gap-[5px] lg:order-1 lg:col-span-3 lg:gap-2.5" data-reveal>
      <p class="label text-sm font-bold lg:font-ultra">{s.contact}</p>
      <a
        href={`mailto:${settings.email}`}
        class="link-line decoration-2 display inline-flex items-center justify-center gap-1 text-[2.25rem] leading-[0.95] tracking-[-0.01em] lg:justify-start lg:text-[1.75rem]"
      >
        {settings.email}
        <Icon name="arrow-ne" class="nudge-ne hidden size-4 lg:block" />
      </a>
    </div>

    <!-- Donate (desktop) -->
    <div class="order-3 hidden flex-col gap-2.5 lg:order-2 lg:col-span-4 lg:flex" data-reveal>
      <p class="label text-sm">{s.donate}</p>
      <a
        href={donate}
        class="link-line decoration-2 display inline-flex items-center gap-1 text-[1.75rem] leading-[0.95]"
      >
        {s.supportUs}
        <Icon name="arrow-ne" class="nudge-ne size-4" />
      </a>
    </div>

    <!-- Socials -->
    <div
      class="order-4 flex flex-col items-center gap-2.5 lg:col-span-12 lg:-mt-10 lg:items-start"
      data-reveal
    >
      <p class="label text-sm font-medium lg:sr-only">{s.socials}</p>
      <Socials socials={settings.socials} />
    </div>

    <!-- Support (mobile) -->
    <a
      href={donate}
      class="display order-5 grid min-h-[105px] place-items-center rounded-[10px] border border-ink p-10 text-2xl hover:bg-ink hover:text-yellow lg:hidden"
    >
      {s.supportUs}
    </a>

    <div class="order-6 mt-10 lg:col-span-12 lg:mt-0">
      <Logo class="h-auto w-full" />
    </div>

    <div class="label order-7 flex flex-col items-center gap-4 text-sm lg:col-span-12 lg:flex-row lg:justify-between lg:-mt-8">
      <p>© {year} La Converse</p>
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2">
        <li>
          <a href={href(lang, "about")} class="link-line">
            {s.about}
          </a>
        </li>
        <li>
          <a href={href(lang, "getInvolved")} class="link-line">
            {s.getInvolved}
          </a>
        </li>
        <li>
          <a href={href(lang, "contact")} class="link-line">
            {s.contact}
          </a>
        </li>
        <li>
          <a href={donate} class="link-line">
            {s.donate}
          </a>
        </li>
        <li>
          <a href={alternate} class="link-line" hreflang={lang === "en" ? "fr" : "en"}>
            {lang === "en" ? (
              <>
                FR / <u>EN</u>
              </>
            ) : (
              <>
                <u>FR</u> / EN
              </>
            )}
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
