---
/* The big inline category list (SEARCH / TOP STORIES). As links
   by default; on the search page the same markup acts as a filter. */
import { href, t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  categories: { title: string; slug: string; count: number }[];
  current?: string | null;
  total?: number;
  asFilter?: boolean;
}
const { lang, categories, current = null, asFilter = false } = Astro.props;
const s = t(lang);
const item =
  "font-display font-black uppercase leading-[0.95] tracking-[-0.02em] hover:text-ink/70 aria-[current=true]:text-ink";
---

<ul
  class="flex flex-wrap justify-center gap-x-2.5 lg:px-60 gap-y-0.5 md:gap-y-0 text-center font-display font-black leading-[0.95] text-3xl text-ink/40 md:text-5xl *:not-last:after:ml-2.5 *:not-last:after:content-['·'_/_'']"
  data-filter-list
>
  <li>
    <a
      href={href(lang, "search")}
      data-filter=""
      aria-current={!current ? "true" : "false"}
      class={item}
    >
      {s.all}
    </a>
  </li>
  {categories.map((c) => (
    <li>
      <a
        href={asFilter ? `${href(lang, "search")}?c=${c.slug}` : href(lang, "category", c.slug)}
        data-filter={c.slug}
        aria-current={current === c.slug ? "true" : "false"}
        class={item}
      >
        {c.title}
      </a>
    </li>
  ))}
</ul>
