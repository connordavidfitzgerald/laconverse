---
/* Section heading with an optional “see all” link beside it (mobile) or under
   it (desktop rails). */
import { t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  title: string;
  href?: string;
  class?: string;
  stacked?: boolean;
}
const { lang, title, href: link, class: className, stacked = false } = Astro.props;
---

<div
  class:list={[
    "flex items-baseline justify-between gap-2.5",
    stacked && "lg:flex-col lg:items-start lg:gap-5",
    className,
  ]}
>
  <h2 class="display text-section tracking-[-0.015em] lg:tracking-[-0.02em]">{title}</h2>
  {link && (
    <a
      href={link}
      class="shrink-0 text-xs font-medium lg:label lg:text-base lg:font-extrabold lg:normal-case"
    >
      {t(lang).seeAll} <span class="nudge-x">→</span>
    </a>
  )}
</div>
