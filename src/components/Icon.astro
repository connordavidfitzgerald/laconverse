---
/* Glyphs from the Figma file, drawn in `currentColor`. */
type Name =
  | "heart"
  | "search"
  | "mic"
  | "chevron"
  | "arrow"
  | "arrow-ne"
  | "play"
  | "pause"
  | "stop"
  | "redo"
  | "close"
  | "share"
  | "plus"
  | "mail"
  | "instagram"
  | "tiktok"
  | "whatsapp"
  | "linkedin"
  | "facebook"
  | "youtube"
  | "x";
interface Props {
  name: Name | string;
  class?: string;
  label?: string;
}
const { name, class: className, label } = Astro.props;
const a11y: Record<string, string> = label
  ? { role: "img", "aria-label": label }
  : { "aria-hidden": "true" };
---

