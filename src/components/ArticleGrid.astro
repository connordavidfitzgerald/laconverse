---
/* A list of story cards with “sort” header and a “load more” that pulls the
   remaining cards from /<lang>/index.json, filtered the same way. */
import ArticleCard from "./ArticleCard.astro";
import Icon from "./Icon.astro";
import { t, type Lang } from "../i18n";
import type { ArticleCard as Card } from "../lib/types";

interface Props {
  lang: Lang;
  articles: Card[];
  total: number;
  /** Filter applied to the JSON index for "load more". */
  filter?: { category?: string; tag?: string; author?: string };
  countLabel?: string;
  /** Leave “load more” to a parent (the search page drives its own). */
  managed?: boolean;
  /** Extra classes for the card list (column gaps differ per page). */
  listClass?: string;
  /** Label for the “load more” button. */
  moreLabel?: string;
  /** Two-up cards beside the explorer (Figma: Sujet — gabarit), without the
      sort bar. Default: three-up cards under the bar. */
  explore?: boolean;
}
const {
  lang,
  articles,
  total,
  filter = {},
  countLabel,
  managed = false,
  listClass,
  moreLabel,
  explore = false,
} = Astro.props;
const s = t(lang);
// A `filter` slot (ArticleSearch's categories) goes between the sort bar and
// the cards; the bar then reads as a top rule rather than a bottom one.
const hasFilter = Astro.slots.has("filter");
const sizes = explore ? "(min-width: 1024px) 31vw, (min-width: 768px) 50vw, 100vw" : undefined;
// The client-side card template: a card with every slot present, filled per entry.
const blank: Card = {
  _id: "",
  title: "",
  slug: "",
  publishedAt: new Date(0).toISOString(),
  categories: [{ slug: "", title: "" }],
  authors: [{ slug: "", name: "" }],
};
---

<article-grid
  data-lang={lang}
  data-category={filter.category}
  data-tag={filter.tag}
  data-author={filter.author}
  data-shown={articles.length}
  data-managed={managed ? "" : undefined}
>
  <div
    class:list={[
      "flex items-center justify-between border-ink",
      hasFilter ? "border-t pt-5" : "border-b py-2.5",
      explore && "hidden",
    ]}
  >
    <p class="label inline-flex items-center gap-1.5 text-sm font-medium">
      {s.sortLatest}
      <Icon name="chevron" class="h-1.5 w-2.5" />
    </p>
    <p class="label text-sm font-medium" data-count>
      {total} {countLabel ?? s.results}
    </p>
  </div>
  <slot name="filter" />
  <div
    data-list
    class:list={[
      explore ? "grid gap-x-10 gap-y-4 md:grid-cols-2" : "mt-5 grid gap-5 md:grid-cols-2 lg:grid-cols-3",
      listClass,
    ]}
  >
    {articles.map((a) => (
      <ArticleCard article={a} lang={lang} sizes={sizes} />
    ))}
  </div>
  {(managed || total > articles.length) && (
    <p class="py-30 text-center">
      <button
        type="button"
        data-more
        class="btn w-cols-3"
      >
        {moreLabel ?? s.loadMore}
      </button>
    </p>
  )}
  <template data-card>
    <ArticleCard article={blank} lang={lang} sizes={sizes} />
  </template>
</article-grid>

<script>
  import { fadeImages } from "../lib/motion";
  import { cardLinks, loadIndex, type Entry } from "../lib/searchClient";

  class ArticleGrid extends HTMLElement {
    connectedCallback() {
      const more = this.querySelector<HTMLButtonElement>("[data-more]");
      if (!more || this.hasAttribute("data-managed")) return;
      more.addEventListener("click", async () => {
        more.disabled = true;
        const { lang, category, tag, author } = this.dataset;
        const all = (await loadIndex(lang!)).filter(
          (e) =>
            (!category || e.c.some((c) => c.slug === category)) &&
            (!tag || e.g?.includes(tag)) &&
            (!author || e.a.some((a) => a.slug === author)),
        );
        const shown = Number(this.dataset.shown);
        const next = all.slice(shown, shown + 12);
        this.render(next);
        this.dataset.shown = String(shown + next.length);
        more.disabled = false;
        if (shown + next.length >= all.length) more.closest("p")!.remove();
      });
    }

    render(entries: Entry[]) {
      const tpl = this.querySelector<HTMLTemplateElement>("[data-card]")!;
      const list = this.querySelector("[data-list]")!;
      const added: Element[] = [];
      for (const e of entries) {
        const node = tpl.content.cloneNode(true) as DocumentFragment;
        cardLinks(node, e, this.dataset.lang!);
        added.push(...node.children);
        list.append(node);
      }
      fadeImages(added);
    }
  }
  customElements.define("article-grid", ArticleGrid);
</script>
