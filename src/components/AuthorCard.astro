---
import Picture from "./Picture.astro";
import { href, type Lang } from "../i18n";
import type { Person } from "../lib/types";

interface Props {
  person: Person;
  lang: Lang;
  class?: string;
}
const { person, lang, class: className } = Astro.props;
---

<a
  href={href(lang, "author", person.slug)}
  class:list={["group flex gap-4 border border-ink p-2.5 hover:bg-yellow", className]}
  data-reveal
>
  <Picture img={person.image} ratio={1} class="w-[134px] shrink-0 md:w-40" sizes="160px" />
  <div class="flex flex-col gap-4 py-1">
    <p class="display text-lg leading-[0.95]">
      {person.name}
      {person.role && (
        <>
          <br />
          <span class="opacity-50">{person.role}</span>
        </>
      )}
    </p>
    {person.bio && <p class="display text-sm leading-[0.95] md:text-base">{person.bio}</p>}
  </div>
</a>
