---
/* Figma: Sujet — gabarit. Laid out like the search page: the search bar
   (searching within the section), the section's chip and description, then
   the sticky explorer with the section current beside two-up story cards. */
import ArticleGrid from "../components/ArticleGrid.astro";
import ExploreNav from "../components/ExploreNav.astro";
import SearchForm from "../components/SearchForm.astro";
import SectionIntro from "../components/SectionIntro.astro";
import Layout from "../layouts/Layout.astro";
import { href, otherLang, t, type Lang } from "../i18n";
import { getCategories } from "../lib/content";
import type { TaxonomyPage } from "../lib/types";

/* Sections and topics share the page; a topic shows the section list without
   a current one. */
interface Props {
  lang: Lang;
  category: TaxonomyPage;
  kind?: "category" | "tag";
}
const { lang, category, kind = "category" } = Astro.props;
const s = t(lang);
const categories = await getCategories(lang);
// The same section or topic in the other language, when it has a slug there.
const other = otherLang(lang);
const otherSlug = category.alternates?.[other];
---

<Layout
  lang={lang}
  title={category.title}
  description={category.description}
  alternate={otherSlug ? href(other, kind, otherSlug) : href(other, "search")}
>
  <div class="px-5 pt-5 pb-20 lg:px-page lg:pt-[55px] lg:pb-30">
    <h1 class="sr-only">{category.title}</h1>
    <SearchForm lang={lang} category={kind === "category" ? category.slug : null} />
    {category.description && (
      <SectionIntro lang={lang} category={category} chip={kind === "category"} />
    )}
    <div class="pt-10 lg:page-grid lg:pt-20">
      <ExploreNav
        lang={lang}
        categories={categories}
        current={kind === "category" ? category.slug : null}
        class="pb-10 lg:sticky lg:top-[calc(var(--header-h)+2.5rem)] lg:col-span-4 lg:self-start lg:pb-0"
      />
      <div class="lg:col-span-8 lg:col-start-5">
        <ArticleGrid
          lang={lang}
          articles={category.articles}
          total={category.total}
          filter={kind === "category" ? { category: category.slug } : { tag: category.slug }}
          countLabel={s.articlesCount}
          explore
        />
      </div>
    </div>
  </div>
</Layout>
