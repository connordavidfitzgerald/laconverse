---
/* Figma: École Converse — JOURNALISM, MC CONVERSE and PODCASTS (the last one
   served as the podcasts index, /balados). One template:
   title, the program's square, the intro, "About" with the join button, then
   whichever of graduates' articles, music videos and podcasts the program
   has, and its alumni. */
import AlumniGrid from "../components/AlumniGrid.astro";
import LabelRow from "../components/LabelRow.astro";
import PageTitle from "../components/PageTitle.astro";
import Picture from "../components/Picture.astro";
import StoryLine from "../components/StoryLine.astro";
import YouTubeEmbed from "../components/YouTubeEmbed.astro";
import Layout from "../layouts/Layout.astro";
import { href, otherLang, t, type Lang } from "../i18n";
import { renderRichText } from "../lib/portableText";
import type { Program } from "../lib/types";

interface Props {
  lang: Lang;
  program: Program;
}
const { lang, program } = Astro.props;
const s = t(lang);
const other = otherLang(lang);
const translation = program.translations.find((x) => x.language === other);
// The podcasts program is shown at the podcasts index, not under École.
const alternate =
  program.linkTo === "podcasts"
    ? href(other, "podcasts")
    : translation
      ? href(other, "program", translation.slug)
      : href(other, "ecole");
const seeAll = href(lang, "search");
const row = "pt-20 lg:pt-30";
---

<Layout
  lang={lang}
  mediaTint="var(--color-lilac)"
  title={program.title}
  description={program.tagline}
  image={program.image}
  seo={program.seo}
  alternate={alternate}
>
  <PageTitle>{program.title}</PageTitle>
  <div class="px-5 lg:page-grid lg:px-page">
    <Picture
      img={program.image}
      ratio={1}
      eager
      sizes="(min-width: 1024px) 30vw, 70vw"
      fill="#b49a7b"
      class="mx-auto w-[70%] lg:col-span-4 lg:col-start-5 lg:w-full"
    />
    {program.body && (
      <div
        class="prose-lead mt-10 lg:col-span-12 lg:mt-30"
        set:html={renderRichText(program.body)}
      />
    )}
  </div>

  {(program.about || program.cta?.url) && (
    <LabelRow label={s.aboutLabel} class={row}>
      {/* Two columns of 4 across the row's 8 on desktop */}
      {program.about && (
        <div
          class="text-copy font-bold leading-[1.15] tracking-[-0.03em] text-pretty lg:columns-2 lg:gap-10 [&>*+*]:mt-[1em]"
          set:html={renderRichText(program.about)}
        />
      )}
      {program.cta?.url && (
        <a
          href={program.cta.url}
          class="btn btn-lilac press mt-10 w-cols-3"
        >
          {program.cta.label ?? s.joinEcole}
        </a>
      )}
    </LabelRow>
  )}

  {program.articles.length > 0 && (
    <LabelRow class={row}>
      <Fragment slot="label">
        {s.gradArticles}
        <a href={seeAll} class="mt-5 block opacity-50 hover:opacity-100 lg:mt-0">
          {s.seeAll} <span class="nudge-x">→</span>
        </a>
      </Fragment>
      {program.articles.map((a) => (
        <StoryLine article={a} lang={lang} />
      ))}
      <div class="border-t border-ink"></div>
    </LabelRow>
  )}

  {program.musicVideos.length > 0 && (
    <LabelRow label={s.musicVideos} class={row}>
      <ul class="flex flex-col gap-20 lg:gap-30">
        {program.musicVideos.map((v) => (
          <li>
            <YouTubeEmbed url={v.url} title={v.title} poster={v.poster} lang={lang} />
            <div class="mt-5 flex items-baseline justify-between gap-5">
              <h3 class="display text-item">{v.title}</h3>
              {v.year && <p class="display text-item">({v.year})</p>}
            </div>
            {v.text && (
              <p class="label mt-5 text-copy leading-[0.95] lg:mt-10 lg:max-w-[75%]">{v.text}</p>
            )}
            {(v.artists || v.mentor) && (
              <dl class="mt-5 grid grid-cols-[auto_1fr] gap-x-5 gap-y-2.5 font-display text-copy font-medium uppercase leading-[0.95] lg:mt-10 lg:grid-cols-8 lg:gap-x-10 lg:gap-y-5">
                {v.artists && (
                  <>
                    <dt class="lg:col-span-2">{s.artists}</dt>
                    <dd class="lg:col-span-5">{v.artists}</dd>
                  </>
                )}
                {v.mentor && (
                  <>
                    <dt class="lg:col-span-2">{s.mentorArtist}</dt>
                    <dd class="lg:col-span-5">{v.mentor}</dd>
                  </>
                )}
              </dl>
            )}
          </li>
        ))}
      </ul>
    </LabelRow>
  )}

  {program.podcasts.length > 0 && (
    <LabelRow label={s.podcasts} class={row}>
      <ul class="grid gap-10 md:grid-cols-2 md:gap-x-5 lg:gap-x-10 lg:gap-y-20">
        {program.podcasts.map((p) => (
          <li>
            <article class="group relative">
              <Picture
                img={p.cover}
                ratio={1}
                sizes="(min-width: 768px) 30vw, 100vw"
                class="media-inset"
              />
              <a
                href={href(lang, "podcast", p.slug)}
                aria-label={p.title}
                class="absolute inset-0 z-10"
              ></a>
              {p.description && (
                <p class="mt-5 text-copy font-bold leading-[1.15] tracking-[-0.03em] text-pretty">
                  {p.description}
                </p>
              )}
              <p class="label mt-5 flex items-center gap-2 text-copy">
                <span aria-hidden="true">▶</span>
                {p.episodeCount} {s.episodes}
              </p>
            </article>
          </li>
        ))}
      </ul>
    </LabelRow>
  )}

  {program.alumni.length > 0 && (
    <LabelRow label={s.alumni} class={row}>
      <AlumniGrid people={program.alumni} lang={lang} />
    </LabelRow>
  )}

  <div class="pb-20 lg:pb-30"></div>
</Layout>
