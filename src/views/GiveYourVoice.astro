---
/* Careers, on the contact page's shape: the centred title, a full-width photo
   (École Converse's "why" photo), the intro as the lead, then two label rows (label left, content right):
   the open positions, and the open application with its form. */
import AjaxForm from "../components/AjaxForm.astro";
import FormFields from "../components/FormFields.astro";
import LabelRow from "../components/LabelRow.astro";
import PageTitle from "../components/PageTitle.astro";
import Picture from "../components/Picture.astro";
import Layout from "../layouts/Layout.astro";
import { href, otherLang, t, type Lang } from "../i18n";
import { getEcole, getGiveYourVoice } from "../lib/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const [page, ecole] = await Promise.all([getGiveYourVoice(lang), getEcole(lang)]);
const title = page.title ?? s.careers;
const image = ecole.why?.image ?? null;
const app = page.openApplication;
---

<Layout
  lang={lang}
  mediaTint="var(--color-lilac)"
  title={title}
  description={page.intro}
  image={image}
  seo={page.seo}
  alternate={href(otherLang(lang), "giveYourVoice")}
>
  <PageTitle>{title}</PageTitle>
  <div class="px-5 lg:px-page">
    <Picture
      img={image}
      ratio={1648 / 924}
      sizes="100vw"
      widths={[640, 960, 1280, 1920, 2560]}
      eager
      fill="var(--color-lilac)"
      class="max-md:aspect-[4/3]!"
    />
    {page.intro && (
      <div class="prose-lead mt-5 lg:mt-10">
        <p>{page.intro}</p>
      </div>
    )}
  </div>

  <!-- Open positions: the label in cols 1–4, the post titles from col 5 -->
  {page.positions.length > 0 && (
    <LabelRow label={s.openPositions} class="pt-30 lg:pt-60">
      <ul class="flex flex-col">
        {page.positions.map((p) => (
          <li>
            <a
              href={href(lang, "position", p.slug)}
              class="display link-line decoration-2 block text-lead leading-[0.95] text-balance"
            >
              {p.title}{" "}
              <span aria-hidden="true" class="nudge-ne inline-block font-medium">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </LabelRow>
  )}

  <!-- Open application: same row shape, its title as the label, the line
       and the form beside it -->
  <LabelRow label={app?.title} class="pt-30 lg:pt-60">
    {app?.text && (
      <p class="text-copy font-bold leading-[1.15] tracking-[-0.03em] text-pretty lg:max-w-[75%]">
        {app.text}
      </p>
    )}
    <AjaxForm action="/api/contact" lang={lang} class={app?.text ? "mt-10 lg:mt-15" : undefined}>
      <input type="hidden" name="kind" value="application" />
      <input type="hidden" name="context" value="Open application" />
      <FormFields lang={lang}>
        <button
          type="submit"
          class="btn press mt-5 self-start w-cols-3"
        >
          {s.submit}
        </button>
      </FormFields>
    </AjaxForm>
  </LabelRow>

  <div class="pb-20 lg:pb-30"></div>
</Layout>
