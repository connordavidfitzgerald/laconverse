---
/* Figma: 8A DONNEZ VOTRE VOIX — UI (careers). */
import AjaxForm from "../components/AjaxForm.astro";
import BackLink from "../components/BackLink.astro";
import FormFields from "../components/FormFields.astro";
import Icon from "../components/Icon.astro";
import Picture from "../components/Picture.astro";
import Layout from "../layouts/Layout.astro";
import { href, otherLang, t, type Lang } from "../i18n";
import { getGiveYourVoice } from "../lib/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const page = await getGiveYourVoice(lang);
---

<Layout
  lang={lang}
  title={page.title}
  seo={page.seo}
  alternate={href(otherLang(lang), "giveYourVoice")}
>
  <div class="px-5 lg:grid lg:grid-cols-12 lg:gap-x-5 lg:px-5">
    <div class="lg:col-span-8 lg:col-start-3">
      <p class="pt-5 text-center">
        <BackLink href={href(lang, "getInvolved")} label={s.getInvolved} />
      </p>
      <h1 class="display pt-5 text-center text-mega tracking-[-0.02em]">{page.title}</h1>
      {page.intro && (
        <p class="mx-auto mt-2.5 max-w-md text-center font-display text-lg font-extrabold leading-[0.95] lg:max-w-2xl lg:text-intro">
          {page.intro}
        </p>
      )}

      {page.positions.length > 0 && (
        <section class="mt-20" aria-labelledby="open">
          <h2 id="open" class="label text-[0.625rem] lg:text-xs">
            {s.openPositions}
          </h2>
          <ul class="mt-5 flex flex-col gap-5">
            {page.positions.map((p) => (
              <li>
                <a
                  href={href(lang, "position", p.slug)}
                  class="group flex items-start justify-between gap-5"
                >
                  <span>
                    <span class="display block text-2xl leading-[0.95] lg:text-4xl">{p.title}</span>
                    {p.meta && (
                      <span class="label block text-[0.625rem] opacity-40 lg:text-xs">
                        {p.meta}
                      </span>
                    )}
                  </span>
                  <Icon name="arrow-ne" class="nudge-ne mt-1 size-2.5 shrink-0 lg:size-4" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="mt-20" aria-labelledby="open-app">
        <h2 id="open-app" class="display text-[1.875rem] leading-[0.95] lg:text-5xl">
          {page.openApplication?.title}
        </h2>
        {page.openApplication?.text && (
          <p class="mt-1 font-display text-sm font-extrabold leading-[0.95] lg:text-xl">
            {page.openApplication.text}
          </p>
        )}
        <AjaxForm action="/api/contact" lang={lang} class="mt-6">
          <input type="hidden" name="kind" value="application" />
          <input type="hidden" name="context" value="Open application" />
          <FormFields lang={lang}>
            <button
              type="submit"
              class="press label mt-4 h-[76px] w-full rounded-[10px] bg-yellow text-sm hover:bg-ink hover:text-yellow disabled:opacity-60"
            >
              {s.submit}
            </button>
          </FormFields>
        </AjaxForm>
      </section>

      {page.culture && (
        <section class="mt-20 pb-20" aria-labelledby="culture">
          <h2 id="culture" class="display text-[1.875rem] leading-[0.95] lg:text-5xl">
            {page.culture.title}
          </h2>
          <Picture
            img={page.culture.image}
            ratio={353 / 235}
            class="mt-2.5"
            sizes="(min-width: 1024px) 66vw, 100vw"
          />
          {page.culture.text && (
            <p class="mt-5 font-display text-2xl font-bold leading-[0.95] lg:text-intro">
              {page.culture.text}
            </p>
          )}
        </section>
      )}
    </div>
  </div>
</Layout>
