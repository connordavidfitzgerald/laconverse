---
/* Figma: ÉCOLE CONVERSE (2026 desktop frame). Title, photo, the intro, the
   three programs as kraft cards, the approach beside its photo, then why:
   the lead across the page, a photo in cols 1–7 and the copy and button in
   cols 8–12. Every block below the title is optional. */
import PageTitle from "../components/PageTitle.astro";
import Picture from "../components/Picture.astro";
import Layout from "../layouts/Layout.astro";
import { href, otherLang, t, type Lang } from "../i18n";
import { getEcole } from "../lib/content";
import { renderRichText } from "../lib/portableText";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const page = await getEcole(lang);
const title = page.title ?? s.ecole;
const { why, approach } = page;
const hasWhy = Boolean(why?.title || why?.body);
const programUrl = (p: { slug: string; linkTo?: string | null }) =>
  p.linkTo === "podcasts" ? href(lang, "podcasts") : href(lang, "program", p.slug);
const button =
  "label press inline-grid place-items-center bg-lilac px-6 py-3.5 text-copy hover:bg-ink hover:text-lilac lg:px-8 lg:py-4";
---

<Layout
  lang={lang}
  mediaTint="var(--color-lilac)"
  title={title}
  seo={page.seo}
  image={page.image}
  alternate={href(otherLang(lang), "ecole")}
>
  <PageTitle>{title}</PageTitle>
  <div class="px-5 lg:px-page">
    <Picture
      img={page.image}
      ratio={1648 / 924}
      sizes="100vw"
      widths={[640, 960, 1280, 1920, 2560]}
      eager
      fill="var(--color-lilac)"
      class="max-md:aspect-[4/3]!"
    />
    {page.intro && <div class="prose-lead mt-5 lg:mt-10" set:html={renderRichText(page.intro)} />}
  </div>

  <!-- Programs: three kraft squares, centred, titles under -->
  {page.programs.length > 0 && (
    <section class="px-5 pt-20 lg:px-page lg:pt-30" aria-labelledby="programs-title">
      <h2 id="programs-title" class="label text-center text-copy">
        {s.ourPrograms}
      </h2>
      <ul class="mx-auto mt-5 grid max-w-[1090px] grid-cols-3 gap-2.5 lg:mt-15 lg:gap-10">
        {page.programs.map((p) => (
          <li>
            <a href={programUrl(p)} class="group relative block">
              <Picture
                img={p.image}
                ratio={1}
                sizes="(min-width: 1024px) 20vw, 33vw"
                fill="#b49a7b"
                class="media-inset"
              />
              <span class="display mt-2.5 block text-center text-sm lg:mt-5 lg:text-[2.65rem]">
                {p.title}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Approach: copy in cols 1–4, photo in 7–12 -->
  {approach?.body && (
    <section class="px-5 pt-20 lg:px-page lg:pt-30" aria-labelledby="approach-title">
      <h2 id="approach-title" class="label text-copy">
        {approach.title ?? s.approach}
      </h2>
      <div class="mt-5 flex flex-col gap-10 lg:page-grid lg:mt-10">
        <div class="lg:grid lg:grid-cols-6 lg:gap-10 col-span-6 flex flex-col">
          <div
            class="text-copy font-bold leading-[1.15] tracking-[-0.03em] text-pretty lg:col-span-4 [&>*+*]:mt-[1em]"
            set:html={renderRichText(approach.body)}
          />
        </div>

        <Picture
          img={approach.image}
          ratio={801 / 705}
          sizes="(min-width: 1024px) 47vw, 100vw"
          class="lg:col-span-6 lg:col-start-7"
        />
      </div>
    </section>
  )}

  <!-- Why: the lead full width, then photo (cols 1–7) beside copy + button (8–11) -->
  {why && hasWhy && (
    <section class="px-5 pt-20 pb-20 lg:px-page lg:pt-30 lg:pb-30" aria-labelledby="why-title">
      <h2 id="why-title" class="label text-copy">
        {why.title ?? s.whyEcole}
      </h2>
      {why.body && <div class="prose-lead mt-5 lg:mt-10" set:html={renderRichText(why.body)} />}
      <div class="mt-10 flex flex-col gap-10 lg:page-grid lg:mt-20">
        <Picture
          img={why.image}
          ratio={16 / 9}
          sizes="(min-width: 1024px) 55vw, 100vw"
          class="lg:col-span-7"
        />
        <div class="flex flex-col gap-10 lg:col-span-4 lg:col-start-8">
          {why.aside && (
            <div
              class="text-copy font-bold leading-[1.15] tracking-[-0.03em] text-pretty [&>*+*]:mt-[1em]"
              set:html={renderRichText(why.aside)}
            />
          )}
          {page.cta?.url && (
            <a href={page.cta.url} class:list={[button, "self-start"]}>
              {page.cta.label ?? s.joinEcole}
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Without a why block, the button still closes the page -->
  {!hasWhy && page.cta?.url && (
    <section class="px-5 pt-20 pb-20 lg:px-page lg:pt-30 lg:pb-30">
      <a href={page.cta.url} class={button}>
        {page.cta.label ?? s.joinEcole}
      </a>
    </section>
  )}
</Layout>
