---
/* Figma: Sujet — gabarit (search). The search bar, then the explorer beside
   two-up story cards. The first 12 stories render statically; typing or
   picking a section filters the full index client-side. */
import ArticleSearch from "../components/ArticleSearch.astro";
import SearchForm from "../components/SearchForm.astro";
import Layout from "../layouts/Layout.astro";
import { href, otherLang, t, type Lang } from "../i18n";
import { getArticleCount, getCategories, getLatest } from "../lib/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const [total, categories, latest] = await Promise.all([
  getArticleCount(lang),
  getCategories(lang),
  getLatest(lang),
]);
---

<Layout lang={lang} title={s.search} alternate={href(otherLang(lang), "search")}>
  <h1 class="sr-only">{s.search}</h1>
  <ArticleSearch
    lang={lang}
    categories={categories}
    articles={latest}
    total={total}
    syncUrl
    class="px-5 pt-5 pb-20 lg:px-page lg:pt-[55px] lg:pb-30"
  >
    <SearchForm lang={lang} />
  </ArticleSearch>
</Layout>
