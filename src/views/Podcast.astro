---
/* Figma: 6D BALADOS DETAIL — UI. One <audio> for the page; each episode's
   play pill loads into it, and the lilac bar at the top plays the newest. */
import LabelRow from "../components/LabelRow.astro";
import PageTitle from "../components/PageTitle.astro";
import Icon from "../components/Icon.astro";
import Picture from "../components/Picture.astro";
import PodcastCard from "../components/PodcastCard.astro";
import Layout from "../layouts/Layout.astro";
import { formatDuration, href, otherLang, t, type Lang } from "../i18n";
import { getPodcasts } from "../lib/content";
import type { Podcast } from "../lib/types";

interface Props {
  lang: Lang;
  podcast: Podcast;
}
const { lang, podcast } = Astro.props;
const s = t(lang);
const others = (await getPodcasts(lang)).filter((p) => p.slug !== podcast.slug);
const other = otherLang(lang);
const translation = podcast.translations.find((x) => x.language === other);
const row = "pt-20 lg:pt-30";
const pad = (n: number) => `E${String(n).padStart(2, "0")}`;
/* Episodes hosted on Spotify play in Spotify's own player. */
const spotify = (src?: string | null) =>
  src?.match(/open\.spotify\.com\/episode\/([A-Za-z0-9]+)/)?.[1];
const player = (id: string, title: string) =>
  `https://open.spotify.com/embed/episode/${id}?utm_source=generator&title=${encodeURIComponent(title)}`;
---

<Layout
  lang={lang}
  title={podcast.title}
  description={podcast.description}
  image={podcast.cover}
  seo={podcast.seo}
  alternate={translation ? href(other, "podcast", translation.slug) : href(other, "podcasts")}
>
  <PageTitle>{podcast.title}</PageTitle>
  <podcast-player class="block">
    <audio preload="none"></audio>
    <div class="px-5 lg:page-grid lg:px-page">
      <Picture
        img={podcast.image ?? podcast.cover}
        ratio={1}
        eager
        sizes="(min-width: 1024px) 30vw, 70vw"
        class="mx-auto w-[70%] lg:col-span-4 lg:col-start-5 lg:w-full"
      />
      {podcast.intro && (
        <div class="prose-lead mt-10 lg:col-span-12 lg:mt-30">
          <p>{podcast.intro}</p>
        </div>
      )}
    </div>

    {podcast.episodes.length > 0 && (
      <LabelRow label={s.episodesHeading} class={row}>
        <ol class="border-b border-ink">
          {podcast.episodes.map((e, i) => (
            <li class="grid grid-cols-[44px_1fr] gap-x-2 border-t border-ink py-5 lg:grid-cols-[80px_1fr] lg:py-10">
              <span class="display text-2xl leading-[0.95] lg:text-4xl">{pad(i + 1)}</span>
              <div class="flex flex-col gap-2.5">
                <h3 class="display text-2xl leading-[0.95] lg:text-4xl">{e.title}</h3>
                {e.description && (
                  <p class="font-display text-body font-medium leading-[0.95]">
                    {e.description}
                  </p>
                )}
                {spotify(e.src) ? (
                  <iframe
                    src={player(spotify(e.src)!, e.title)}
                    title={e.title}
                    class="mt-2.5 h-[152px] w-full rounded-[12px] lg:mt-5"
                    loading="lazy"
                    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                  ></iframe>
                ) : e.src ? (
                  <button
                    type="button"
                    data-episode={e.src}
                    data-title={e.title}
                    class="press group label inline-flex w-max items-center gap-2 rounded-full bg-ink px-3 py-1.5 text-xs text-paper hover:bg-ink/80"
                  >
                    <Icon name="play" class="h-2 w-2 group-aria-pressed:hidden" />
                    <Icon name="pause" class="hidden h-2 w-2 group-aria-pressed:block" />
                    {formatDuration(e.duration)}
                  </button>
                ) : e.duration ? (
                  <span class="label inline-flex w-max items-center gap-2 rounded-full bg-ink px-3 py-1.5 text-xs text-paper">
                    <Icon name="play" class="h-2 w-2" />
                    {formatDuration(e.duration)}
                  </span>
                ) : null}
              </div>
            </li>
          ))}
        </ol>
      </LabelRow>
    )}

    {podcast.credits.length > 0 && (
      <LabelRow label={s.credits} class={row}>
        <dl class="grid gap-5 md:grid-cols-2 lg:gap-x-10">
          {podcast.credits.map((c) => (
            <div>
              <dt class="font-display text-copy font-medium opacity-60">{c.role}</dt>
              <dd class="font-display text-copy font-medium">{c.names}</dd>
            </div>
          ))}
        </dl>
        {podcast.note && <p class="mt-10 font-display text-copy font-medium">{podcast.note}</p>}
      </LabelRow>
    )}
  </podcast-player>

  {others.length > 0 && (
    <LabelRow class={`${row} overflow-hidden`}>
      <Fragment slot="label">
        {s.otherPodcasts}
        <a href={href(lang, "podcasts")} class="block opacity-50 hover:opacity-100">
          {s.seeAll} <span class="nudge-x">→</span>
        </a>
      </Fragment>
      <ul class="rail -mr-5 gap-2.5 pr-5 lg:mr-0 lg:gap-10 lg:pr-0">
        {others.map((p) => (
          <li class="w-[207px] lg:w-[calc((100%-5rem)/3)]">
            <PodcastCard podcast={p} lang={lang} />
          </li>
        ))}
      </ul>
    </LabelRow>
  )}

  <div class="pb-20 lg:pb-30"></div>
</Layout>

<script>
  class PodcastPlayer extends HTMLElement {
    connectedCallback() {
      const audio = this.querySelector("audio")!;
      let current: HTMLButtonElement | null = null;
      this.querySelectorAll<HTMLButtonElement>("[data-episode]").forEach((b) =>
        b.addEventListener("click", () => {
          if (current === b && !audio.paused) return audio.pause();
          if (audio.src !== b.dataset.episode) audio.src = b.dataset.episode!;
          current?.removeAttribute("aria-pressed");
          current = b;
          b.setAttribute("aria-pressed", "true");
          audio.play();
        }),
      );
      audio.addEventListener("pause", () => current?.setAttribute("aria-pressed", "false"));
      audio.addEventListener("play", () => current?.setAttribute("aria-pressed", "true"));
    }
  }
  customElements.define("podcast-player", PodcastPlayer);
</script>
