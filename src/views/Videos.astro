---
/* Figma: VIDEO + VIDEO SCROLL. A vertical, snap-scrolling feed: each video
   sits centred between the (compact, inverted) header and the bottom of the
   screen, with a gap either side so the neighbours peek in. The write-up
   opens Instagram-style from a tap anywhere on the caption: on a phone the
   still-playing clip shrinks to the top of the frame and the text scrolls
   below it; on desktop the caption sits beside the video and opens in place.
   Videos play with sound while in view, where the browser allows it; until
   the viewer first taps or clicks, most only allow it muted. Mux clips stream over HLS (natively in
   Safari, through hls.js elsewhere), attached as they near the screen.
   `?c=<type>` (from the video index's filter) keeps only that type. */
import AuthorCard from "../components/AuthorCard.astro";
import Chip from "../components/Chip.astro";
import Picture from "../components/Picture.astro";
import ShareButton from "../components/ShareButton.astro";
import Layout from "../layouts/Layout.astro";
import { formatDate, href, otherLang, t, type Lang } from "../i18n";
import { getVideos } from "../lib/content";
import { embedSrc, plainText, renderRichText } from "../lib/portableText";
import { imageUrl } from "../lib/sanity";
import { videoKindLabel } from "../lib/videoKinds";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const videos = await getVideos(lang);
---

<Layout
  lang={lang}
  title={s.videos}
  alternate={href(otherLang(lang), "videos")}
  dark
  compactHeader
  voiceLauncher={false}
  smoothScroll={false}
>
  <video-feed class="flex flex-col items-center gap-(--feed-gap) py-(--feed-gap) [--feed-gap:1.25rem] lg:[--feed-gap:2rem]">
    {videos.map((v, i) => {
      const excerpt = plainText(v.body).slice(0, 200);
      const stream = v.playbackId ? `https://stream.mux.com/${v.playbackId}.m3u8` : null;
      const playable = Boolean(stream || v.src);
      const poster =
        imageUrl(v.poster, 900) ??
        (v.playbackId ? `https://image.mux.com/${v.playbackId}/thumbnail.webp?width=900` : undefined);
      const iframe = !playable && v.videoUrl ? embedSrc(v.videoUrl) : null;
      const kind = videoKindLabel(v.kind, lang);
      return (
        <article
          id={v.slug}
          data-kind={v.kind ?? ""}
          lang={v.lang && v.lang !== lang ? v.lang : undefined}
          class="group/slide relative h-(--feed-h) w-full max-w-[calc(var(--feed-h)*9/16)] snap-center overflow-hidden [--feed-h:calc(100dvh-var(--header-h)-2*var(--feed-gap))] [--shrink:0.4] lg:flex lg:w-auto lg:max-w-none lg:items-start lg:gap-10 lg:overflow-visible"
          data-slide
        >
          <div
            data-stage
            class="absolute inset-0 overflow-hidden lg:relative lg:inset-auto lg:h-full lg:w-[calc(var(--feed-h)*9/16)] lg:shrink-0"
          >
            <!-- The clip itself. With the write-up open on a phone it
                 shrinks to the top of the frame, Instagram-style, and the
                 text takes the space below. -->
            <div
              data-media
              class="absolute inset-0 origin-top bg-neutral-900 transition-transform duration-500 ease-power3-out group-data-shrunk/slide:translate-y-4 group-data-shrunk/slide:scale-(--shrink) motion-reduce:transition-none lg:group-data-shrunk/slide:translate-y-0 lg:group-data-shrunk/slide:scale-100"
            >
              {playable ? (
                <video
                  src={stream ? undefined : v.src!}
                  data-hls={stream}
                  poster={poster}
                  class="absolute inset-0 size-full object-cover"
                  muted
                  loop
                  playsinline
                  preload={i === 0 ? "auto" : "none"}
                  data-video
                ></video>
              ) : iframe ? (
                /* A poster stands in for the player until it's asked for:
                   each embed costs ~0.5 MB of third-party script. */
                <button
                  type="button"
                  data-embed={iframe}
                  data-title={v.title}
                  aria-label={`${s.playVideo} : ${v.title}`}
                  class="group absolute inset-0 size-full cursor-pointer"
                >
                  <Picture img={v.poster} class="absolute! inset-0 size-full" ratio={9 / 16} />
                  <span
                    aria-hidden="true"
                    class="absolute left-1/2 top-1/2 grid size-16 -translate-1/2 place-items-center rounded-full bg-ink/60 text-2xl text-paper transition-colors group-hover:bg-ink/80"
                  >
                    ▶
                  </span>
                </button>
              ) : (
                <Picture
                  img={v.poster}
                  class="absolute! inset-0 size-full"
                  ratio={9 / 16}
                  eager={i === 0}
                />
              )}
            </div>

            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-x-0 bottom-0 h-64 bg-linear-to-t from-ink/80 via-ink/40 to-transparent transition-opacity duration-300 group-data-shrunk/slide:opacity-0 lg:hidden"
            ></div>

            <a
              href={href(lang, "home")}
              data-exit
              class="press label absolute left-4 top-4 rounded-full bg-ink/60 px-3 py-1.5 text-xs text-paper hover:bg-ink/80"
            >
              <span class="nudge-back">←</span> {s.back}
            </a>

            {playable && (
              <button
                type="button"
                data-playback
                class="press label absolute right-4 top-14 overflow-hidden rounded-full bg-ink/60 px-3 py-1.5 text-xs text-paper hover:bg-ink/80"
                data-on={s.pause}
                data-off={s.play}
              >
                {s.pause}
              </button>
            )}
            {playable && (
              <button
                type="button"
                data-sound
                class="press label absolute right-4 top-4 overflow-hidden rounded-full bg-ink/60 px-3 py-1.5 text-xs text-paper hover:bg-ink/80"
                data-on={s.mute}
                data-off={s.unmute}
              >
                {s.mute}
              </button>
            )}
          </div>

          <!-- Caption and write-up in one block: over the foot of the video
               on a phone (below the shrunk video once open), beside it on
               desktop. Folded, a tap anywhere on it opens it; open, a tap on
               the title folds it. -->
          <div
            data-text
            class="absolute inset-x-0 bottom-0 cursor-pointer px-5 pt-6 pb-[30px] text-paper [scrollbar-width:none] group-data-open/slide:top-[calc(var(--feed-h)*var(--shrink)+2.25rem)] group-data-open/slide:cursor-auto group-data-open/slide:overflow-y-auto group-data-open/slide:overscroll-contain group-data-open/slide:pt-0 group-data-open/slide:pb-10 lg:static lg:max-h-full lg:w-[30rem] xl:w-[36rem] lg:overflow-y-auto lg:overscroll-contain lg:p-0"
          >
            {kind && (
              <p lang={lang} class="label mb-2 inline-flex items-baseline gap-[0.45em] text-xs font-black">
                <span aria-hidden="true" class="size-[1cap] shrink-0 bg-yellow" />
                {kind}
              </p>
            )}
            <div data-head class="flex items-end justify-between gap-4 group-data-open/slide:cursor-pointer">
              <h2 class="display text-2xl leading-[0.95]">{v.title}</h2>
              <button
                type="button"
                data-toggle
                aria-expanded="true"
                aria-controls={`body-${v.slug}`}
                class="hidden shrink-0 pb-0.5 text-base font-medium opacity-70 group-data-open/slide:block hover:opacity-100"
              >
                {s.less}
              </button>
            </div>
            <p
              data-excerpt
              class="mt-2 flex text-base font-medium group-data-open/slide:hidden lg:flex-col lg:items-start"
            >
              <span class="truncate lg:line-clamp-3 lg:whitespace-normal">{excerpt}…</span>
              <button
                type="button"
                data-toggle
                aria-expanded="false"
                aria-controls={`body-${v.slug}`}
                class="shrink-0 pl-1 opacity-70 hover:opacity-100 lg:mt-1 lg:pl-0"
              >
                {s.more}
              </button>
            </p>
            <div id={`body-${v.slug}`} class="hidden group-data-open/slide:block">
              <div
                data-rise
                class="prose-article mt-6 text-base! [&_a]:text-yellow"
                set:html={renderRichText(v.body)}
              />
              <div
                data-rise
                class="mt-10 flex items-center justify-between border-t border-paper pt-5"
              >
                <p class="label text-xs font-black">{formatDate(lang, v.publishedAt)}</p>
                <ShareButton lang={lang} title={v.title} />
              </div>
              {v.categories[0] && (
                <div data-rise>
                  <Chip category={v.categories[0]} lang={lang} class="mt-5 text-ink" />
                </div>
              )}
              {v.authorsFull[0] && (
                <div data-rise>
                  <AuthorCard
                    person={v.authorsFull[0]}
                    lang={lang}
                    class="mt-10 border-paper bg-paper text-ink"
                  />
                </div>
              )}
            </div>
          </div>
        </article>
      );
    })}
  </video-feed>
</Layout>

<script>
  import { d, gsap, reduced, swapText } from "../lib/motion";

  /* A Mux stream is attached once, the first time it's needed, through
     hls.js (fetched once) wherever Media Source is available. Native HLS is
     only the fallback (older iPhones): Chrome now claims it too, but its
     player fails on Mux's streams. */
  let hlsLib: Promise<typeof import("hls.js").default> | undefined;
  const attached = new WeakMap<HTMLVideoElement, Promise<void>>();
  function attach(v: HTMLVideoElement): Promise<void> {
    const url = v.dataset.hls;
    if (!url) return Promise.resolve();
    if (!attached.has(v))
      attached.set(
        v,
        (async () => {
          const Hls = await (hlsLib ??= import("hls.js").then((m) => m.default));
          if (!Hls.isSupported()) {
            v.src = url;
            return;
          }
          const hls = new Hls({ capLevelToPlayerSize: true });
          hls.loadSource(url);
          hls.attachMedia(v);
        })(),
      );
    return attached.get(v)!;
  }

  const SNAP = ["snap-y", "snap-mandatory"];
  const SOUND_KEY = "feed-sound";
  // Tailwind's lg: the write-up sits beside the video rather than under it.
  const desktop = matchMedia("(width >= 64rem)");

  class VideoFeed extends HTMLElement {
    connectedCallback() {
      // Opened from the video index with a type picked (?c=): only that
      // type's videos, so scrolling goes to the next one of the same type.
      // Then back to the linked video, which the dropped slides above it had
      // pushed down.
      const kind = new URLSearchParams(location.search).get("c");
      if (kind) {
        this.querySelectorAll<HTMLElement>("[data-slide]").forEach((s) => {
          if (s.dataset.kind !== kind) s.remove();
        });
        const target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if (target) target.scrollIntoView({ block: "center", behavior: "instant" });
      }
      document.documentElement.classList.add(...SNAP);
      // Mandatory snapping would otherwise hold the page on the last video.
      const footer = document.querySelector<HTMLElement>("body > footer");
      if (footer) footer.style.scrollSnapAlign = "end";

      // Play what is on screen, pause the rest; a slide leaving the screen
      // also folds its write-up away. A video the viewer paused (or every
      // video, with reduced motion) stays paused until they press play.
      const held = new WeakSet<HTMLVideoElement>();
      const onScreen = new WeakSet<HTMLVideoElement>();

      // Sound is on unless the viewer turned it off (remembered for the
      // visit). Browsers refuse to start a video with sound before the
      // first tap, click or key press: it then plays muted, and that first
      // gesture anywhere on the page turns the sound on.
      let wantSound = sessionStorage.getItem(SOUND_KEY) !== "off";
      const play = (v: HTMLVideoElement) => {
        v.muted = !wantSound;
        v.play().catch(() => {
          if (v.muted) return;
          v.muted = true;
          v.play().catch(() => {});
        });
      };
      const onGesture = (e: Event) => {
        if (!wantSound || (e.target as Element).closest?.("[data-sound]")) return;
        // Not every key counts (Escape doesn't): unmuting without a real
        // gesture would get the video paused instead.
        if (navigator.userActivation && !navigator.userActivation.isActive) return;
        this.querySelectorAll<HTMLVideoElement>("[data-video]").forEach((v) => {
          if (!v.paused) v.muted = false;
        });
      };
      document.addEventListener("click", onGesture, true);
      document.addEventListener("keydown", onGesture, true);
      this.#offGesture = () => {
        document.removeEventListener("click", onGesture, true);
        document.removeEventListener("keydown", onGesture, true);
      };
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            const slide = e.target as HTMLElement;
            const v = slide.querySelector<HTMLVideoElement>("[data-video]");
            if (e.isIntersecting) {
              if (!v) return;
              onScreen.add(v);
              attach(v).then(() => {
                if (onScreen.has(v) && !held.has(v)) play(v);
              });
            } else {
              if (v) onScreen.delete(v);
              v?.pause();
              this.#close(slide);
            }
          }),
        { threshold: 0.6 },
      );
      this.querySelectorAll<HTMLElement>("[data-slide]").forEach((s) => io.observe(s));

      // Streams start loading a screen ahead, so the next clip is ready.
      const near = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            near.unobserve(e.target);
            attach(e.target as HTMLVideoElement);
          }),
        { rootMargin: "100% 0px" },
      );
      this.querySelectorAll<HTMLVideoElement>("video[data-hls]").forEach((v) => near.observe(v));

      this.querySelectorAll<HTMLButtonElement>("[data-playback]").forEach((b) => {
        const v = b.parentElement!.querySelector("video")!;
        if (reduced()) {
          held.add(v);
          b.textContent = b.dataset.off!;
        }
        b.addEventListener("click", () => {
          if (v.paused) {
            held.delete(v);
            attach(v).then(() => play(v));
          } else {
            held.add(v);
            v.pause();
          }
        });
        v.addEventListener("play", () => swapText(b, b.dataset.on!));
        v.addEventListener("pause", () => swapText(b, b.dataset.off!));
      });

      // Embeds: swap the poster for the player when it's pressed.
      this.querySelectorAll<HTMLButtonElement>("[data-embed]").forEach((b) =>
        b.addEventListener("click", () => {
          const frame = document.createElement("iframe");
          const src = new URL(b.dataset.embed!);
          src.searchParams.set("autoplay", "1");
          frame.src = src.href;
          frame.title = b.dataset.title!;
          frame.allow = "autoplay; encrypted-media; picture-in-picture";
          frame.allowFullscreen = true;
          frame.className = "absolute inset-0 size-full";
          b.replaceWith(frame);
          frame.focus();
        }),
      );

      // The button names what pressing it does, following the video's actual
      // state (which the browser, or the first gesture, may change).
      this.querySelectorAll<HTMLButtonElement>("[data-sound]").forEach((b) => {
        const v = b.parentElement!.querySelector("video")!;
        let wasMuted = v.muted;
        v.addEventListener("volumechange", () => {
          if (v.muted !== wasMuted) swapText(b, v.muted ? b.dataset.on! : b.dataset.off!);
          wasMuted = v.muted;
        });
        b.addEventListener("click", () => {
          v.muted = !v.muted;
          wantSound = !v.muted;
          sessionStorage.setItem(SOUND_KEY, wantSound ? "on" : "off");
        });
      });

      // Folded, a tap anywhere on the caption opens it; open, a tap on the
      // title row folds it (the rest is the article, with links to follow).
      this.querySelectorAll<HTMLElement>("[data-text]").forEach((text) =>
        text.addEventListener("click", (e) => {
          const slide = text.closest<HTMLElement>("[data-slide]")!;
          if (!this.#isOpen(slide)) this.#open(slide);
          // Focus goes back to "more" only for the keyboard (a click from
          // Enter/Space has no detail); a tap shouldn't leave a focus ring.
          else if ((e.target as Element).closest("[data-head]")) this.#close(slide, e.detail === 0);
        }),
      );
      // A tap on the shrunk video goes back to it (and doesn't start an
      // embed). The corner controls keep working.
      this.querySelectorAll<HTMLElement>("[data-stage]").forEach((stage) =>
        stage.addEventListener(
          "click",
          (e) => {
            const slide = stage.closest<HTMLElement>("[data-slide]")!;
            if (slide.dataset.shrunk === undefined || desktop.matches) return;
            if ((e.target as Element).closest("a, [data-sound], [data-playback]")) return;
            e.preventDefault();
            e.stopPropagation();
            this.#close(slide);
          },
          true,
        ),
      );
      // Exit returns to the page the viewer came from on this site, else home.
      const cameFromSite = document.referrer.startsWith(location.origin) && history.length > 1;
      const home = this.querySelector<HTMLAnchorElement>("[data-exit]")!.href;
      const exit = () => (cameFromSite ? history.back() : location.assign(home));
      this.querySelectorAll<HTMLAnchorElement>("[data-exit]").forEach((a) =>
        a.addEventListener("click", (e) => {
          if (!cameFromSite) return;
          e.preventDefault();
          exit();
        }),
      );

      // Escape folds an open write-up; with none open, it leaves the feed.
      document.addEventListener(
        "keydown",
        (this.#onKey = (e: KeyboardEvent) => {
          if (e.key !== "Escape" || e.defaultPrevented) return;
          // Only from the feed itself, not from the header, menu or voice note.
          const target = e.target as Element;
          if (target !== document.body && !this.contains(target)) return;
          const open = this.querySelector<HTMLElement>("[data-slide][data-open]:not([data-closing])");
          if (open) this.#close(open, true);
          else exit();
        }),
      );
    }

    #onKey?: (e: KeyboardEvent) => void;
    #offGesture?: () => void;

    #parts(slide: HTMLElement) {
      return {
        text: slide.querySelector<HTMLElement>("[data-text]")!,
        head: slide.querySelector<HTMLElement>("[data-head]")!,
        excerpt: slide.querySelector<HTMLElement>("[data-excerpt]")!,
        more: slide.querySelector<HTMLButtonElement>("[data-excerpt] [data-toggle]")!,
        less: slide.querySelector<HTMLButtonElement>("[data-head] [data-toggle]")!,
        rise: [...slide.querySelectorAll<HTMLElement>("[data-rise]")],
      };
    }

    #isOpen(slide: HTMLElement) {
      return slide.dataset.open !== undefined && slide.dataset.closing === undefined;
    }

    /** Switch the layout and slide the title from where it was to where it
        lands (up over the shrinking video on a phone, nowhere on desktop). */
    #flip(head: HTMLElement, change: () => void) {
      const before = head.getBoundingClientRect().top;
      change();
      const dy = before - head.getBoundingClientRect().top;
      gsap.fromTo(
        head,
        { y: dy },
        { y: 0, duration: d(0.6), ease: "expo.out", clearProps: "transform" },
      );
    }

    /** The video shrinks out of the way (CSS, on phones), the title rises
        to the top of the text and the write-up follows it block by block. */
    #open(slide: HTMLElement) {
      if (this.#isOpen(slide)) return;
      const { text, head, excerpt, less, rise } = this.#parts(slide);
      delete slide.dataset.closing;
      gsap.killTweensOf([head, excerpt, ...rise]);
      gsap.set([excerpt, ...rise], { clearProps: "transform,opacity" });
      slide.dataset.shrunk = "";
      this.#flip(head, () => {
        slide.dataset.open = "";
        text.scrollTop = 0;
      });
      gsap.fromTo(
        rise,
        { y: 40, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: d(0.7),
          stagger: d(0.05),
          ease: "expo.out",
          delay: d(0.1),
          clearProps: "transform,opacity",
        },
      );
      less.focus({ preventScroll: true });
    }

    /** The write-up fades, the video grows back, and the title settles
        back over it with the excerpt. */
    #close(slide: HTMLElement, restoreFocus = false) {
      if (!this.#isOpen(slide)) return;
      const { text, head, excerpt, more, rise } = this.#parts(slide);
      slide.dataset.closing = "";
      delete slide.dataset.shrunk;
      gsap.killTweensOf([head, excerpt, ...rise]);
      gsap.to(rise, {
        y: 20,
        opacity: 0,
        duration: d(0.2),
        ease: "power2.in",
        onComplete: () => {
          text.scrollTop = 0;
          this.#flip(head, () => {
            delete slide.dataset.open;
            delete slide.dataset.closing;
          });
          gsap.set(rise, { clearProps: "transform,opacity" });
          gsap.fromTo(
            excerpt,
            { opacity: 0, y: 8 },
            {
              opacity: 1,
              y: 0,
              duration: d(0.4),
              delay: d(0.15),
              ease: "power3.out",
              clearProps: "transform,opacity",
            },
          );
          if (restoreFocus) more.focus({ preventScroll: true });
        },
      });
    }

    disconnectedCallback() {
      document.documentElement.classList.remove(...SNAP);
      if (this.#onKey) document.removeEventListener("keydown", this.#onKey);
      this.#offGesture?.();
    }
  }
  customElements.define("video-feed", VideoFeed);
</script>
