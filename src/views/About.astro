---
/* Figma: ABOUT (2026 desktop frame). Title, illustration, the intro, two
   statements stepping across the grid, then the values carousel and the
   numbered principles beside their image. The team, partners and news follow on the same
   grid. */
import ArticleCard from "../components/ArticleCard.astro";
import AlumniGrid from "../components/AlumniGrid.astro";
import LabelRow from "../components/LabelRow.astro";
import PageTitle from "../components/PageTitle.astro";
import Picture from "../components/Picture.astro";
import RailControls from "../components/RailControls.astro";
import Layout from "../layouts/Layout.astro";
import { href, otherLang, t, type Lang } from "../i18n";
import { getAbout } from "../lib/content";
import { renderRichText } from "../lib/portableText";
import { imageUrl } from "../lib/sanity";
import type { Person } from "../lib/types";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const page = await getAbout(lang);
const title = page.title ?? s.about;
const groups: [string, Person[]][] = [
  [s.ourTeam, page.team],
  [s.collaborators, page.collaborators],
];
// The statements step right and down: cols 3–6, then 7–10, a row each
// (the columns don't overlap, so the row is set explicitly).
// Of the expanding sections only the news (a series' articles) is shown.
const news = page.sections.filter((sec) => sec.kind === "series" && sec.articles?.length);
const statementCols = ["lg:col-start-3 lg:col-span-4", "lg:col-start-7 lg:col-span-4"];
---

<Layout lang={lang} title={title} seo={page.seo} image={page.image} alternate={href(otherLang(lang), "about")}>
  <PageTitle>{title}</PageTitle>
  <div class="px-5 lg:px-page">
    <Picture
      img={page.image}
      ratio={1648 / 924}
      eager
      sizes="100vw"
      fill="var(--color-lilac)"
      class="max-md:aspect-[4/3]!"
    />
    <div class="prose-lead mt-5 lg:mt-10" set:html={renderRichText(page.intro)} />
  </div>

  {page.statements.length > 0 && (
    <div class="flex flex-col gap-10 px-5 pt-20 lg:page-grid lg:gap-y-56 lg:px-page lg:pt-60">
      {page.statements.map((st, i) => (
        <div class:list={[statementCols[i % 2]]} style={`grid-row: ${i + 1}`}>
          <p class="text-copy font-bold leading-[1.15] tracking-[-0.03em]">{st.text}</p>
          {st.cta?.url && (
            <a
              href={st.cta.url}
              class="label mt-5 inline-block text-copy font-medium underline underline-offset-[0.2em] hover:no-underline lg:mt-10"
            >
              {st.cta.label ?? s.learnMoreEcole} <span class="nudge-x">→</span>
            </a>
          )}
        </div>
      ))}
    </div>
  )}

  <!-- Values (Figma: ABOUT NEW): heading over a rail of numbered yellow
       cards that starts at the margin and bleeds off the right; swipe or
       arrows on every size. -->
  {page.values.length > 0 && (
    <section class="overflow-hidden pt-20 lg:px-page lg:pt-60" aria-labelledby="about-values-title">
      <div class="px-5 lg:px-0">
        <div class="flex items-end justify-between gap-5">
          <h2 id="about-values-title" class="display text-section max-w-[20ch] lg:max-w-[46.5vw]">
            {page.valuesTitle ?? s.ourValues}
          </h2>
          <RailControls rail="about-values" count={page.values.length} lang={lang} class="shrink-0 max-md:hidden" />
        </div>
        <ol
          id="about-values"
          class="rail -mr-5 mt-10 gap-5 pr-5 lg:-mr-page lg:mt-20 lg:gap-10 lg:pr-page"
        >
          {page.values.map((v, i) => (
            <li class="flex w-[88vw] shrink-0 flex-col gap-2.5 md:w-[60vw] lg:w-[40vw] lg:gap-5">
              <span class="display text-2xl lg:text-[2.25rem]" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="flex-1 bg-yellow p-5 md:p-8 lg:p-14">
                <h3 class="display text-2xl leading-[0.95] lg:text-[2.25rem]">{v.title}</h3>
                {v.text && <p class="prose-sans mt-5 whitespace-pre-line lg:mt-10">{v.text}</p>}
              </div>
            </li>
          ))}
        </ol>
        <RailControls rail="about-values" count={page.values.length} lang={lang} class="mt-5 md:hidden" />
      </div>
    </section>
  )}

  {page.principles.length > 0 && (
    <LabelRow label={s.ourPrinciples} start={4} class="pt-20 lg:pt-60">
      <Picture
        img={page.principlesImage}
        ratio={1226 / 690}
        sizes="(min-width: 1024px) 71vw, 100vw"
        class="mb-10 lg:mb-20"
      />
      <!-- Number, then title (Favorit) and body (Inter Bold) from the third column -->
      <ol class="flex flex-col gap-10 lg:gap-20">
        {page.principles.map((pr, i) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-x-5 lg:grid-cols-9 lg:gap-x-10">
            <span class="display text-2xl leading-[0.95] lg:col-span-2 lg:text-[2.25rem]" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div class="lg:col-span-7 lg:grid lg:grid-cols-7 lg:gap-x-10">
              <h3 class="display text-2xl leading-[0.95] lg:col-span-5 lg:text-[2.25rem]">{pr.title}</h3>
              <!-- Title and body take 5 of the 7 columns -->
              <div class="prose-sans mt-5 lg:col-span-5 lg:mt-10" set:html={renderRichText(pr.body)} />
            </div>
          </li>
        ))}
      </ol>
    </LabelRow>
  )}

  {groups
    .filter(([, list]) => list.length)
    .map(([label, list]) => (
      <LabelRow label={label} class="pt-20 lg:pt-30">
        <AlumniGrid people={list} lang={lang} />
      </LabelRow>
    ))}

  {page.partners.length > 0 && (
    <LabelRow label={s.partners} class="pt-20 lg:pt-30">
      <ul class="grid grid-cols-3 items-center gap-5 md:grid-cols-4 lg:grid-cols-6 lg:gap-10">
        {page.partners.map((p) => {
          const logo = imageUrl(p.logo, 300);
          return (
            <li>
              <a
                href={p.url ?? undefined}
                target="_blank"
                rel="noopener"
                class="block hover:opacity-60"
              >
                {logo ? (
                  <img
                    src={logo}
                    alt={p.name}
                    class="mx-auto max-h-16 w-auto object-contain"
                    loading="lazy"
                  />
                ) : (
                  <span class="label text-sm">{p.name}</span>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </LabelRow>
  )}

  <!-- News: the series' stories two-up, as in the homepage's Explorer
       (careers and funding sections are no longer shown). -->
  {news.map((sec) => (
    <LabelRow label={sec.title} class="pt-20 pb-20 lg:pt-30 lg:pb-30">
      <div class="grid gap-y-4 md:grid-cols-2 md:gap-x-10">
        {sec.articles!.map((a) => (
          <ArticleCard article={a} lang={lang} sizes="(min-width: 768px) 31vw, 100vw" />
        ))}
      </div>
    </LabelRow>
  ))}
</Layout>

