---
/* Figma: STUDIO CONVERSE. Title, photo, the kicker and pitch, then the
   studios two across from col 3, each with its booking link. */
import LabelRow from "../components/LabelRow.astro";
import PageTitle from "../components/PageTitle.astro";
import Picture from "../components/Picture.astro";
import Layout from "../layouts/Layout.astro";
import { href, otherLang, t, type Lang } from "../i18n";
import { getStudio } from "../lib/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const page = await getStudio(lang);
const title = page.title ?? "Studio Converse";
---

<Layout
  lang={lang}
  title={title}
  description={page.intro}
  image={page.image}
  seo={page.seo}
  alternate={href(otherLang(lang), "studio")}
>
  <PageTitle>{title}</PageTitle>
  <div class="px-5 lg:px-page">
    <Picture img={page.image} ratio={1649 / 927} eager sizes="100vw" class="max-md:aspect-[4/3]!" />
    {(page.kicker || page.intro) && (
      <div class="display mt-5 text-lead lg:mt-10">
        {page.kicker && <p>{page.kicker}</p>}
        {page.intro && <p class="mt-[1em]">{page.intro}</p>}
      </div>
    )}
  </div>

  {page.studios.length > 0 && (
    <LabelRow label={s.studios} start={3} class="pt-20 pb-20 lg:pt-30 lg:pb-30">
      <ul class="grid gap-10 md:grid-cols-2 md:gap-x-5 lg:gap-x-10 lg:gap-y-10">
        {page.studios.map((st) => (
          <li class="flex flex-col">
            <Picture img={st.image} ratio={664 / 443} sizes="(min-width: 768px) 40vw, 100vw" />
            <div class="mt-5 flex items-start justify-between gap-5">
              <h3 class="display text-item">{st.name}</h3>
              {st.bookUrl && (
                <a
                  href={st.bookUrl}
                  target={st.bookUrl.startsWith("http") ? "_blank" : undefined}
                  rel="noopener"
                  class="label shrink-0 pt-[0.3em] text-body link-line"
                  aria-label={`${s.book} — ${st.name}`}
                >
                  {s.book} <span class="nudge-x">→</span>
                </a>
              )}
            </div>
            {st.text && <p class="label mt-5 text-copy leading-[0.95] lg:mt-10">{st.text}</p>}
          </li>
        ))}
      </ul>
    </LabelRow>
  )}
</Layout>
