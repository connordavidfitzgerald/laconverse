---
/* Figma: HOMEPAGE (mobile) + HOME (2026 desktop frame) on the 12-column
   grid (`page-grid`, 40px margins and gaps). Lead story in cols 1–9 with
   three stories in 10–12; the sections list beside six two-up stories; the
   donate widget; the videos rail; École Converse. */
import ArticleCard from "../components/ArticleCard.astro";
import Chip from "../components/Chip.astro";
import DonateWidget from "../components/DonateWidget.astro";
import ExploreNav from "../components/ExploreNav.astro";
import Logo from "../components/Logo.astro";
import Picture from "../components/Picture.astro";
import PodcastCard from "../components/PodcastCard.astro";
import SectionTitle from "../components/SectionTitle.astro";
import VideoCard from "../components/VideoCard.astro";
import Layout from "../layouts/Layout.astro";
import { formatDate, href, otherLang, t, type Lang } from "../i18n";
import { getCategories, getDonate, getHome, getLatest } from "../lib/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const [home, donate, categories, latest] = await Promise.all([
  getHome(lang),
  getDonate(lang),
  getCategories(lang),
  getLatest(lang, 12),
]);
const { lead, topStories, videos, podcasts } = home;
const ecoleHref = href(lang, "ecole");
const ecoleTitle = home.ecole?.title ?? "École Converse";
const ecoleText =
  home.ecole?.text ??
  (lang === "en"
    ? "Through training in journalism, podcasting, video and journalistic rap, it supports a new generation of journalists and artists who want to reclaim their stories and explore new ways of telling the world."
    : "À travers des formations en journalisme, en balado, en vidéo et en rap journalistique, elle accompagne une nouvelle génération de journalistes et d’artistes qui souhaitent se réapproprier leurs récits et explorer de nouvelles façons de raconter le monde.");
// Desktop: the three stories beside the lead.
const sideStories = topStories.filter((a) => a._id !== lead?._id).slice(0, 3);
// The Explorer skips the lead and side stories so nothing shows twice.
const shownIds = [lead, ...sideStories].filter((a) => a != null).map((a) => a._id);
const rows = latest.filter((a) => !shownIds.includes(a._id)).slice(0, 6);
// The Explorer's client-side card template: every slot present, filled per entry.
const blank = {
  _id: "",
  title: "",
  slug: "",
  publishedAt: new Date(0).toISOString(),
  categories: [{ slug: "", title: "" }],
  authors: [],
};
---

<Layout lang={lang} seo={home.seo} alternate={href(otherLang(lang), "home")}>
  <!-- Lead story, straight under the header. Desktop: lead in cols 1–9, three
       stories stacked in 10–12. -->
  {lead && (
    <section
      data-header-hero
      class="bg-white px-2.5 pb-10 lg:page-grid lg:items-start lg:px-page lg:pb-0"
    >
      <article class="group relative flex flex-col lg:col-span-9">
        <Picture
          img={lead.image}
          eager
          sizes="(min-width: 1024px) 71vw, 100vw"
          class="order-1 lg:aspect-video! w-full h-auto"
        />
        <div class="order-2 px-2.5 flex flex-col items-center gap-5 pt-[60px] text-center lg:items-start lg:px-0 lg:pt-5 lg:pb-5 lg:text-left">
          <div class="flex w-full items-center justify-center gap-2 lg:justify-between">
            {lead.categories[0] ? (
              <Chip category={lead.categories[0]} lang={lang} class="relative z-10" />
            ) : (
              <span />
            )}
            <time
              datetime={lead.publishedAt}
              class="label hidden shrink-0 text-sm font-medium whitespace-nowrap opacity-60 lg:block"
            >
              {formatDate(lang, lead.publishedAt)}
            </time>
          </div>
          <h1 class="display text-hero font-black pt-2 lg:pt-0 lg:text-[4.5rem]">
            <a href={href(lang, "article", lead.slug)} class="after:absolute after:inset-0">
              {lead.title}
            </a>
          </h1>
          <div class="flex flex-col items-center gap-5 lg:items-start">
            {lead.dek && (
              <p class="font-display text-[1.625rem] font-medium leading-[0.95] lg:text-[1.8rem] lg:leading-[1]">
                {lead.dek}
              </p>
            )}
            {lead.authors[0] && (
              <p class="text-sm font-medium label lg:hidden">
                {s.by}{" "}
                <a
                  href={href(lang, "author", lead.authors[0].slug)}
                  class="relative z-10 link-line"
                >
                  {lead.authors[0].name}
                </a>
              </p>
            )}
          </div>
        </div>
      </article>
      {sideStories.length > 0 && (
        <ul class="hidden lg:col-span-3 lg:flex lg:flex-col lg:gap-2.5">
          {sideStories.map((a) => (
            <li>
              <ArticleCard article={a} lang={lang} size="lg" sizes="22vw" />
            </li>
          ))}
        </ul>
      )}
    </section>
  )}

  <!-- Stories. Phones: the card grid. Desktop: the sections list in cols 1–4
       beside three ruled story rows in 5–12. -->
  <section class="px-5 pt-16 lg:page-grid lg:px-page lg:pt-30" aria-label={s.topStories}>
    <div class="grid gap-5 md:grid-cols-2 lg:hidden">
      {topStories
        .filter((a) => a._id !== lead?._id)
        .map((a) => (
          <ArticleCard article={a} lang={lang} />
        ))}
    </div>
    <p class="py-[60px] text-center lg:hidden">
      <a href={href(lang, "search")} class="label text-lg">
        {s.seeAllStories} <span class="nudge-x">→</span>
      </a>
    </p>

    <!-- Explorer: the sections list in cols 1–4 filters six two-up stories
         in 5–12 (Figma: HOME). -->
    <home-explore
      class="hidden lg:col-span-12 lg:grid lg:grid-cols-subgrid"
      data-lang={lang}
      data-exclude={shownIds.join(" ")}
      data-search={href(lang, "search")}
    >
      <ExploreNav lang={lang} categories={categories} class="lg:col-span-4">
        <a href={href(lang, "search")} data-all class="label mt-10 inline-block text-copy">
          {s.seeAll} <span class="nudge-x">→</span>
        </a>
      </ExploreNav>
      <div class="lg:col-span-8 lg:col-start-5">
        <div data-list class="grid grid-cols-2 gap-x-10 gap-y-4">
          {rows.map((a) => (
            <ArticleCard article={a} lang={lang} sizes="31vw" />
          ))}
        </div>
      </div>
      <template data-row>
        <ArticleCard article={blank} lang={lang} sizes="31vw" />
      </template>
    </home-explore>
  </section>

  <!-- Support: the donate widget (Phones: under the stories) -->
  <DonateWidget lang={lang} data={donate} class="px-5 pb-20 lg:px-page lg:py-30" />

  <!-- Videos: title and greyed "see all" stacked, the rail starting at the
       margin and bleeding off the right. -->
  {videos.length > 0 && (
    <section class="overflow-hidden pb-10 lg:px-page lg:pb-0">
      <div class="px-5 lg:px-0">
        <SectionTitle lang={lang} title={s.videos} href={href(lang, "videoIndex")} rail />
        <ul
          id="home-videos"
          class="rail -mr-5 mt-2.5 gap-2.5 pr-5 lg:-mr-page lg:mt-10 lg:gap-5 lg:pr-page"
        >
          {videos.map((v) => (
            <li class="w-[207px] lg:w-[16.85vw]">
              <VideoCard video={v} lang={lang} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Podcasts: the first four in a row, ruled like Videos. Phones: a rail. -->
  {podcasts.length > 0 && (
    <section class="overflow-hidden pt-10 lg:px-page lg:pt-30">
      <div class="px-5 lg:px-0">
        <SectionTitle lang={lang} title={s.podcasts} href={href(lang, "podcasts")} rail />
        <ul
          id="home-podcasts"
          class="rail -mr-5 mt-2.5 gap-2.5 pr-5 lg:mr-0 lg:mt-10 lg:grid lg:grid-cols-4 lg:gap-5 lg:overflow-visible lg:pr-0"
        >
          {podcasts.map((p, i) => (
            <li class:list={["w-[207px] lg:w-auto", i >= 4 && "lg:hidden"]}>
              <PodcastCard podcast={p} lang={lang} episodes={false} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- École Converse. Phones: title, photo, copy, button. Desktop: title and
       "learn more" stacked top-left, the copy at the foot of cols 1–4, the
       photo in 5–12. -->
  <section class="flex flex-col px-5 pt-10 pb-20 lg:page-grid lg:px-page lg:pt-30 lg:pb-30">
    <div class="contents lg:col-span-4 lg:flex lg:flex-col">
      <h2 class="section-head">
        <a href={ecoleHref}>{ecoleTitle}</a>
      </h2>
      <a href={ecoleHref} class="section-head hidden text-[#949494] hover:text-ink lg:block">
        {s.learnMore}
        <span class="nudge-x">→</span>
      </a>
      <p class="prose-sans order-1 mt-5 lg:mt-auto lg:pt-10">
        {ecoleText}
      </p>
      <a
        href={ecoleHref}
        class="label order-1 mt-5 w-max bg-lilac px-[15px] py-2.5 text-xs leading-[1.2] hover:bg-ink hover:text-lilac lg:hidden"
      >
        {s.learnMore} <span class="nudge-x">→</span>
      </a>
    </div>
    <a
      href={ecoleHref}
      class="group relative mt-5 block lg:col-span-8 lg:col-start-5 lg:mt-0"
      tabindex="-1"
      aria-hidden="true"
    >
      <Picture
        img={home.ecole?.image}
        ratio={1078 / 604}
        class="media-inset [--inset:var(--color-lilac)]"
        sizes="(min-width: 1024px) 63vw, 100vw"
      />
      <Logo class="absolute bottom-[22px] left-[19px] h-[18px] w-auto text-paper lg:hidden" />
    </a>
  </section>
</Layout>

<script>
  import { fadeImages } from "../lib/motion";
  import { cardLinks, loadIndex, type Entry } from "../lib/searchClient";

  /* Explorer: the sections list filters the six stories beside it from the
     article index (minus the stories already shown above). Links stay real
     category pages without JS. */
  class HomeExplore extends HTMLElement {
    entries: Entry[] | null = null;

    connectedCallback() {
      this.querySelectorAll<HTMLAnchorElement>("[data-filter]").forEach((a) =>
        a.addEventListener("click", (e) => {
          e.preventDefault();
          this.show(a.dataset.filter ?? "");
        }),
      );
    }

    async show(category: string) {
      const lang = this.dataset.lang!;
      this.querySelectorAll<HTMLAnchorElement>("[data-filter]").forEach((a) =>
        a.setAttribute("aria-current", String((a.dataset.filter ?? "") === category)),
      );
      if (!this.entries) {
        const exclude = new Set(this.dataset.exclude?.split(" "));
        this.entries = (await loadIndex(lang)).filter((e) => !exclude.has(e.id));
      }
      const tpl = this.querySelector<HTMLTemplateElement>("[data-row]")!;
      const list = this.querySelector("[data-list]")!;
      const rows = this.entries
        .filter((e) => !category || e.c.some((c) => c.slug === category))
        .slice(0, 6)
        .map((e) => {
          const node = tpl.content.cloneNode(true) as DocumentFragment;
          cardLinks(node, e, lang);
          return node;
        });
      const added = rows.flatMap((n) => [...n.children]);
      list.replaceChildren(...rows);
      fadeImages(added);
      // "See all" follows the filter to the search page.
      const all = this.querySelector<HTMLAnchorElement>("[data-all]")!;
      all.href = category ? `${this.dataset.search}?c=${category}` : this.dataset.search!;
    }
  }
  customElements.define("home-explore", HomeExplore);
</script>
