---
/* Figma: 8 ENGAGEZ-VOUS — UI (mobile only; desktop extrapolates the homepage
   12-column grid). The hero mirrors About: mega title, wide image, indented
   intro. Then a numbered index of the ways to help, each card as an
   image/text split that alternates sides, the donate options in a full-bleed
   yellow band, and volunteering as a two-column list. Favorit only: the
   wrappers set `font-display` so no Inter shows through. */
import InvolvedCard from "../components/InvolvedCard.astro";
import Picture from "../components/Picture.astro";
import Spray from "../components/Spray.astro";
import Layout from "../layouts/Layout.astro";
import { href, otherLang, t, type Lang } from "../i18n";
import { getGetInvolved, getSettings } from "../lib/content";
import type { Card } from "../lib/types";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const [page, settings] = await Promise.all([getGetInvolved(lang), getSettings(lang)]);

const slug = (text: string) =>
  text
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

/* Sections in page order, shared by the index and the anchors. `#donate` is
   fixed: the footer and support bands link to it. */
type Block = { kind: "card"; card: Card } | { kind: "donate" } | { kind: "volunteer" };
const blocks: (Block & { id: string; title: string; num: string })[] = [
  ...page.cards.map((card): Block => ({ kind: "card", card })),
  ...(page.donate ? [{ kind: "donate" } as Block] : []),
  ...page.cardsAfter.map((card): Block => ({ kind: "card", card })),
  ...(page.volunteer ? [{ kind: "volunteer" } as Block] : []),
].map((b, i) => {
  const title =
    b.kind === "card"
      ? (b.card.title ?? "")
      : b.kind === "donate"
        ? (page.donate?.title ?? s.donate)
        : (page.volunteer?.title ?? "");
  return {
    ...b,
    title,
    num: String(i + 1).padStart(2, "0"),
    id: b.kind === "donate" ? "donate" : slug(title) || `section-${i + 1}`,
  };
});

/* Donate breaks out to full bleed, so the contained blocks render either side
   of it. Cards alternate image side across the whole page. */
const split = blocks.findIndex((b) => b.kind === "donate");
const before = split < 0 ? blocks : blocks.slice(0, split);
const after = split < 0 ? [] : blocks.slice(split + 1);
const donate = split < 0 ? null : blocks[split];
const cardIndex = new Map(
  blocks.filter((b) => b.kind === "card").map((b, i) => [b.id, i] as const),
);
---

<Layout
  lang={lang}
  title={page.title ?? s.getInvolved}
  seo={page.seo}
  alternate={href(otherLang(lang), "getInvolved")}
>
  <div class="px-5 font-display">
    <header>
      <h1 class="display pt-10 pb-16 text-center text-mega tracking-[-0.02em] lg:pt-16">
        {page.title ?? s.getInvolved}
      </h1>
      <Picture img={page.image} ratio={7 / 5} eager sizes="100vw" />
      {page.intro && (
        <div class="prose-intro mx-auto mt-10 max-w-[31rem] lg:max-w-3xl">
          <p>{page.intro}</p>
        </div>
      )}
    </header>

    {blocks.length > 1 && (
      <nav aria-label={page.title ?? s.getInvolved} class="mt-16 lg:mt-24">
        <ol class="border-b-2 border-ink lg:grid lg:auto-cols-fr lg:grid-flow-col lg:border-t-2">
          {blocks.map((b) => (
            <li class="border-t-2 border-ink lg:border-t-0 lg:border-l-2 lg:first:border-l-0 lg:first:*:pl-0">
              <a
                href={`#${b.id}`}
                class="group flex items-baseline gap-4 py-4 lg:h-full lg:flex-col lg:justify-between lg:gap-8 lg:px-5 lg:py-6"
              >
                <span class="label text-xs lg:text-sm">{b.num}</span>
                <span class="display flex w-full items-baseline justify-between gap-4 text-2xl lg:text-3xl">
                  <span class="link-line decoration-2 group-hover:decoration-current">{b.title}</span>
                  <span class="nudge-x text-xl lg:text-2xl" aria-hidden="true">↓</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    {before.map((b) =>
      b.kind === "card" ? (
        <InvolvedCard card={b.card} id={b.id} num={b.num} flip={cardIndex.get(b.id)! % 2 === 1} />
      ) : null,
    )}
  </div>

  {donate && page.donate && (
    <section
      id="donate"
      class="relative mt-20 scroll-mt-24 overflow-hidden bg-yellow px-5 py-16 font-display lg:mt-32 lg:grid lg:grid-cols-12 lg:gap-x-5 lg:py-28"
    >
      <Spray
        class="-left-[55%] top-[45%] w-[190%] -rotate-[25deg] lg:-left-[10%] lg:top-[20%] lg:w-[90%]"
        seed={31}
      />
      <div class="relative lg:col-span-6">
        <p class="label text-xs lg:text-sm">{donate.num}</p>
        <h2 class="display mt-2 text-mega tracking-[-0.02em]">{donate.title}</h2>
        {page.donate.text && (
          <p class="mt-5 max-w-lg text-dek font-extrabold leading-[0.95] lg:mt-8">
            {page.donate.text}
          </p>
        )}
      </div>
      <ul class="relative mt-10 flex flex-col gap-2.5 lg:col-span-5 lg:col-start-8 lg:mt-0 lg:self-end">
        {page.donate.options.map((o) => (
          <li>
            <a
              href={o.url ?? settings.donateUrl ?? "#"}
              class="display press group flex items-baseline justify-between gap-5 bg-ink px-5 py-4 text-[2.25rem] text-yellow hover:bg-paper hover:text-ink lg:px-6 lg:py-5 lg:text-6xl"
            >
              {o.label}
              <span class="nudge-x text-2xl lg:text-4xl" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class="px-5 pb-20 font-display lg:pb-32">
    {after.map((b) => {
      if (b.kind === "card") {
        return (
          <InvolvedCard
            card={b.card}
            id={b.id}
            num={b.num}
            flip={cardIndex.get(b.id)! % 2 === 1}
          />
        );
      }
      if (b.kind !== "volunteer" || !page.volunteer) return null;
      const v = page.volunteer;
      return (
        <section id={b.id} class="mt-20 scroll-mt-24 lg:mt-32 lg:grid lg:grid-cols-12 lg:gap-x-5">
          <div class="lg:col-span-5">
            <p class="label text-xs lg:text-sm">{b.num}</p>
            <h2 class="display mt-2 text-section-lg tracking-[-0.02em]">{b.title}</h2>
            {v.intro && (
              <p class="mt-5 max-w-md text-dek font-extrabold leading-[0.95]">{v.intro}</p>
            )}
            {v.cta?.url && (
              <a
                href={v.cta.url}
                class="label press mt-8 hidden bg-yellow px-6 py-4 text-base hover:bg-ink hover:text-yellow lg:inline-block lg:text-xl"
              >
                {v.cta.label}
              </a>
            )}
          </div>
          <ol class="mt-10 lg:col-span-6 lg:col-start-7 lg:mt-0">
            {v.items.map((it, i) => (
              <li class="grid grid-cols-[2.5rem_1fr] border-t-2 border-ink py-5 last:border-b-2 lg:grid-cols-[4rem_1fr] lg:py-6">
                <span class="label pt-1 text-xs lg:text-sm">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <h3 class="display text-card">{it.title}</h3>
                  {it.text && <p class="mt-1.5 text-lg font-bold leading-[1.1]">{it.text}</p>}
                </div>
              </li>
            ))}
          </ol>
          {v.cta?.url && (
            <a
              href={v.cta.url}
              class="label press mt-8 inline-block bg-yellow px-6 py-4 text-base hover:bg-ink hover:text-yellow lg:hidden"
            >
              {v.cta.label}
            </a>
          )}
        </section>
      );
    })}
  </div>
</Layout>
