---
/* Figma: DONATE. Title, illustration, the intro (a ♥ in it becomes the pink
   heart), the donate widget, then label + text sections. */
import DonateWidget from "../components/DonateWidget.astro";
import PageTitle from "../components/PageTitle.astro";
import Picture from "../components/Picture.astro";
import Layout from "../layouts/Layout.astro";
import { href, otherLang, t, type Lang } from "../i18n";
import { getDonate } from "../lib/content";
import { renderRichText } from "../lib/portableText";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const page = await getDonate(lang);
const title = page.title ?? s.donate;
const HEART = `<svg viewBox="0 0 19 17" aria-hidden="true" class="inline-block h-[0.7em] w-[0.8em] -translate-y-[0.05em] text-pink" fill="currentColor"><path d="M9.32 16.216c-2.014-1.598-3.657-3.009-4.93-4.232C3.134 10.748 2.167 9.56 1.491 8.42.83 7.281.5 6.155.5 5.044c0-.89.193-1.675.58-2.356A3.94 3.94 0 0 1 2.723 1.084C3.432.695 4.245.5 5.164.5c.934 0 1.772.208 2.513.625.757.417 1.313.994 1.667 1.73.354-.736.902-1.313 1.643-1.73.757-.417 1.603-.625 2.537-.625.918 0 1.732.195 2.44.584a3.94 3.94 0 0 1 1.644 1.604c.387.681.58 1.466.58 2.356 0 1.125-.33 2.258-.99 3.397-.661 1.126-1.636 2.314-2.924 3.564-1.273 1.237-2.924 2.64-4.954 4.21Z"/></svg>`;
const intro = renderRichText(page.intro).replaceAll("♥", HEART);
---

<Layout lang={lang} title={title} seo={page.seo} image={page.image} alternate={href(otherLang(lang), "donate")}>
  <PageTitle>{title}</PageTitle>
  <div class="px-5 lg:px-page">
    <Picture
      img={page.image}
      ratio={1648 / 924}
      eager
      sizes="100vw"
      fill="var(--color-yellow)"
      class="max-md:aspect-[4/3]!"
    />
    {intro && <div class="prose-lead mt-5 lg:mt-10" set:html={intro} />}
  </div>

  <DonateWidget lang={lang} data={page} class="px-5 pt-20 lg:px-page lg:pt-60" />

  <!-- Sections: label in cols 5–7 (in line with the widget's “Amassé”),
       copy top-aligned beside it in cols 8–11 -->
  <div class="flex flex-col gap-20 pt-20 pb-20 lg:gap-30 lg:pt-30 lg:pb-30">
    {page.sections.map((sec) => (
      <section class="px-5 lg:page-grid lg:px-page" aria-label={sec.label ?? undefined}>
        {sec.label && (
          <h2 class="label pb-5 text-copy leading-[0.95] lg:col-span-3 lg:col-start-5 lg:pb-0 lg:pr-5">
            {sec.label}
          </h2>
        )}
        <div class="prose-sans lg:col-span-4 lg:col-start-8 lg:row-start-1" set:html={renderRichText(sec.body)} />
      </section>
    ))}
  </div>
</Layout>
