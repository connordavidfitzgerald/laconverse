# Sanity project (public — the Studio at /admin reads these in the browser).
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Server-only. Editor token used by /api/* to store submissions and by the
# Webflow migration script. https://www.sanity.io/manage → API → Tokens
SANITY_WRITE_TOKEN=

# Server-only. Studio "Auto-translate" (src/pages/api/translate.ts). Key from
# https://langbly.com (500,000 characters a month free, billed beyond that).
LANGBLY_API_KEY=

# Server-only. Voice note / written story notifications (src/lib/notify.ts).
# Each channel is skipped while its keys are empty. See README → “Notifications”.
RESEND_API_KEY=
NOTIFY_EMAIL=info@laconverse.com
NOTIFY_FROM=La Converse <noreply@laconverse.com>
# WhatsApp via CallMeBot: number (international, digits only) and the API key
# CallMeBot sent that number, comma-separated (e.g. 15145550123:123456).
CALLMEBOT_WHATSAPP=

# Server-only. Amount raised on the donate bar, read at build time from the
# Zeffy form set on the Donate page. Zeffy → Settings → Integrations → API.
ZEFFY_API_KEY=

# Webflow migration only (read-only site token: CMS, Assets, Sites).
WEBFLOW_TOKEN=
WEBFLOW_SITE_ID=

# Webflow migration only: English translation of the articles (translate.ts).
ANTHROPIC_API_KEY=
# TRANSLATE_MODEL=claude-opus-5-5
